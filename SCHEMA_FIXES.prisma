// ============================================================================
// FIX 5: Fix AutomationConfig Design Limitation
// File: db/prisma/models/automation.prisma
// ============================================================================

// BEFORE:
// model AutomationConfig {
//   userId              Int            @unique @map("user_id")
// }

// AFTER:
model AutomationConfig {
  id                  Int            @id @default(autoincrement())
  userId              Int            @map("user_id")
  name                String         @db.VarChar(100)  // ✓ NEW: Config name
  isDefault           Boolean        @default(false) @map("is_default")  // ✓ NEW
  isEnabled           Boolean        @default(false) @map("is_enabled")
  cronExpression      String?        @map("cron_expression") @db.VarChar(50)
  collectFromAllBands Boolean        @default(true) @map("collect_from_all_bands")
  wholesaleBandIds    String?        @map("wholesale_band_ids") @db.LongText
  aiProvider          AiProvider     @default(GEMINI) @map("ai_provider")
  pricingPolicyId     Int?           @map("pricing_policy_id")
  autoPublish         Boolean        @default(false) @map("auto_publish")
  retailBandIds       String?        @map("retail_band_ids") @db.LongText
  lastRunAt           DateTime?      @map("last_run_at") @db.Timestamp(0)
  nextRunAt           DateTime?      @map("next_run_at") @db.Timestamp(0)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamp(0)
  channelIds          String?        @map("channel_ids") @db.LongText
  retailChannelIds    String?        @map("retail_channel_ids") @db.LongText
  pricingPolicy       PricingPolicy? @relation(fields: [pricingPolicyId], references: [id])
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])          // ✓ CHANGED: Allow multiple configs, unique names per user
  @@index([isEnabled])
  @@index([userId])                 // ✓ NEW: For multi-config lookups
  @@index([userId, isDefault])      // ✓ NEW: Find default config
  @@index([pricingPolicyId])
  @@map("automation_config")
}

// ============================================================================
// FIX 6: Standardize Boolean Field Naming
// File: db/prisma/models/user.prisma
// ============================================================================

// BEFORE:
// model UserLoginLog {
//   success   Boolean  @default(true)
// }

// AFTER:
model UserLoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  provider  String   @db.VarChar(50)
  email     String?  @db.VarChar(255)
  ip        String?  @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(500)
