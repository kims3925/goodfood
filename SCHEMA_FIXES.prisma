// ============================================================================
// FIX 1: Add Foreign Keys for Admin References
// File: db/prisma/models/inquiry.prisma
// ============================================================================

// BEFORE:
// model Inquiry {
//   repliedBy      Int?              @map("replied_by")
// }
// 
// model InquiryReply {
//   adminId        Int?              @map("admin_id")
// }

// AFTER:
model Inquiry {
  id                 Int               @id @default(autoincrement())
  userId             Int               @map("user_id")
  inquiryType        InquiryType       @map("inquiry_type")
  title              String            @db.VarChar(200)
  content            String            @db.Text
  isPrivate          Boolean           @default(false) @map("is_private")
  status             InquiryStatus     @default(PENDING)
  adminReply         String?           @map("admin_reply") @db.Text
  repliedAt          DateTime?         @map("replied_at") @db.Timestamp(0)
  repliedBy          Int?              @map("replied_by")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  publishedProductId Int?              @map("published_product_id")
  
  // ✓ NEW: Add foreign key relation
  repliedByUser      User?             @relation("InquiryRepliedBy", fields: [repliedBy], references: [id], onDelete: SetNull)
  publishedProduct   PublishedProduct? @relation(fields: [publishedProductId], references: [id])
  user               User              @relation("InquiryCreatedBy", fields: [userId], references: [id], onDelete: Cascade)
  replies            InquiryReply[]

  @@index([userId])
  @@index([publishedProductId])
  @@index([status])
  @@index([userId, status])
  @@index([repliedBy])  // ✓ NEW: Index for admin dashboards
  @@map("inquiry")
}

model InquiryReply {
  id        Int      @id @default(autoincrement())
  inquiryId Int      @map("inquiry_id")
  content   String   @db.Text
  isAdmin   Boolean  @default(true) @map("is_admin")
  adminId   Int?     @map("admin_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  
  // ✓ NEW: Add foreign key relation
  admin     User?    @relation("InquiryReplyAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@index([adminId])  // ✓ NEW: Index for admin dashboards
  @@map("inquiry_reply")
}

