// ============================================================================
// FIX 2: Fix OrderItem Cascade Delete Risk
// File: db/prisma/models/order.prisma
// ============================================================================

// BEFORE:
// model OrderItem {
//   publishedProduct   PublishedProduct @relation(fields: [publishedProductId], references: [id])
// }

// AFTER:
model OrderItem {
  id                 Int              @id @default(autoincrement())
  orderId            Int              @map("order_id")
  publishedProductId Int              @map("published_product_id")
  variantId          Int?             @map("variant_id")
  productName        String           @map("product_name") @db.VarChar(500)
  optionSummary      String?          @map("option_summary") @db.VarChar(500)
  thumbnailUrl       String?          @map("thumbnail_url") @db.VarChar(1000)
  quantity           Int
  unitPrice          Decimal          @map("unit_price") @db.Decimal(10, 2)
  totalPrice         Decimal          @map("total_price") @db.Decimal(12, 2)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  
  // ✓ CHANGED: Use Restrict instead of default Cascade
  // This prevents deletion of published product if order items reference it
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  publishedProduct   PublishedProduct @relation(fields: [publishedProductId], references: [id], onDelete: Restrict)
  variant            ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  review             Review?

  @@index([orderId])
  @@index([publishedProductId])
  @@index([variantId])
  @@map("order_item")
}

// ============================================================================
// FIX 3: Add Documentation for Denormalized Fields
// File: db/prisma/models/order.prisma
// ============================================================================

// ADD COMMENT BLOCK TO OrderItem MODEL:

model OrderItem {
  // ========================================
  // HISTORICAL SNAPSHOT - DO NOT MODIFY
  // ========================================
  // These fields store the product state at the time the order was placed.
  // They do NOT automatically sync with Product or ProductVariant changes.
  // 
  // This is INTENTIONAL - preserving historical accuracy of the order.
  // Do NOT attempt to update these fields based on current product state.
  // 
  // If product data changes, order records must retain the original data
  // that was shown to the customer when they placed the order.
  // ========================================
  productName        String           @map("product_name") @db.VarChar(500)
  optionSummary      String?          @map("option_summary") @db.VarChar(500)
  thumbnailUrl       String?          @map("thumbnail_url") @db.VarChar(1000)
  
  // ========================================
  // CURRENT REFERENCES
  // ========================================
  // These relationships point to current data for lookup/validation
  publishedProductId Int              @map("published_product_id")
  variantId          Int?             @map("variant_id")
}

