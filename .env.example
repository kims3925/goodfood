# =====================================
# BandAuto - 환경변수 템플릿
# =====================================
# 이 파일을 .env.local로 복사한 후 실제 값들로 수정하세요
# cp .env.example .env.local

# Database - SQLite (개발용) / PostgreSQL (프로덕션 권장)
DATABASE_URL="file:./prisma/dev.db"
REDIS_URL="redis://localhost:6379"

# Authentication - NextAuth.js 설정
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# =====================================
# AI Services (필수)
# =====================================
# Google Gemini API - 상품 분석용 (필수)
GOOGLE_AI_API_KEY="your-google-gemini-api-key"

# 기타 AI 서비스 (선택사항)
OPENAI_API_KEY="sk-your-openai-key"
CLAUDE_API_KEY="sk-ant-your-claude-key"

# =====================================
# Band API 설정 (필수)
# =====================================
BAND_ACCESS_TOKEN="your-band-access-token"
BAND_REFRESH_TOKEN="your-band-refresh-token"
BAND_CLIENT_ID="your-band-client-id"
BAND_CLIENT_SECRET="your-band-client-secret"
BAND_REDIRECT_URI="http://localhost:3000/api/auth/band/callback"

# =====================================
# 외부 서비스 (선택사항)
# =====================================
# StrokePay 자동화 (레거시, 현재 미사용)
STROKEPAY_ID="your-strokepay-id"
STROKEPAY_PASSWORD="your-strokepay-password"
STROKEPAY_HEADLESS="true"

# Kakao Alimtalk
KAKAO_ALIMTALK_KEY="your-kakao-key"
KAKAO_ALIMTALK_SENDER="your-sender-key"
KAKAO_TEMPLATE_CODE="your-template-code"

# Email Service
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# AWS S3 (Optional)
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-northeast-2"
AWS_S3_BUCKET="bandauto-assets"

# =====================================
# 토스페이먼츠 결제 시스템 (필수)
# =====================================
# 테스트 환경용 키 (실제 서비스 시 프로덕션 키로 변경)
TOSS_PAYMENTS_CLIENT_KEY="test_ck_your_client_key"
TOSS_PAYMENTS_SECRET_KEY="test_sk_your_secret_key"
TOSS_PAYMENTS_WEBHOOK_SECRET="your-webhook-secret"

# 결제 플로우 URL 설정
PAYMENT_SUCCESS_URL="http://localhost:3000/store/payment/success"
PAYMENT_FAIL_URL="http://localhost:3000/store/payment/fail"
PAYMENT_WEBHOOK_URL="http://localhost:3000/api/webhook/payments"

# =====================================
# 쇼핑몰 기본 설정
# =====================================
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
TOSS_PAYMENTS_ORIGIN_URL="http://localhost:3000"

# 배송 설정
FREE_SHIPPING_AMOUNT="30000"          # 무료배송 기준 금액 (원)
DEFAULT_SHIPPING_FEE="3000"           # 기본 배송비 (원)

# 쇼핑몰 정보
SHOP_NAME="BandAuto 쇼핑몰"
SHOP_BUSINESS_NUMBER="000-00-00000"
SHOP_ADMIN_EMAIL="admin@example.com"
SHOP_CUSTOMER_SERVICE="1588-0000"

# SMS 알림 서비스
SMS_API_KEY="your-sms-api-key"
SMS_SENDER="010-0000-0000"

# 택배 조회 API
DELIVERY_TRACKER_API_KEY="your-delivery-api-key"

# =====================================
# 시스템 설정
# =====================================
NODE_ENV="development"
PORT="3000"

# 크론 작업 보안키
CRON_SECRET="bandauto-cron-secret-change-this"

# =====================================
# 프로덕션 환경 주의사항
# =====================================
# 1. DATABASE_URL을 PostgreSQL이나 MySQL로 변경 (SQLite는 프로덕션 비권장)
# 2. NEXTAUTH_SECRET을 강력한 랜덤 키로 변경
# 3. TOSS_PAYMENTS_*_KEY를 운영용 키로 변경 (test_ → live_)
# 4. 모든 URL을 실제 도메인으로 변경 (https://)
# 5. REDIS_URL을 실제 Redis 서버 주소로 변경
# 6. 실제 API 키들로 모든 값 변경