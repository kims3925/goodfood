# 데이터베이스
DATABASE_URL="mysql://banduser:YOUR_PASSWORD@localhost:3306/sourcing_db"

# 이미지 저장 경로
PRODUCT_IMAGE_STORAGE_PATH="~/assets/images/product"
POST_IMAGE_STORAGE_PATH="~/assets/images/post"
CHANNEL_IMAGE_STORAGE_PATH="~/assets/images/channel"
SHOP_IMAGE_STORAGE_PATH="~/assets/images/shop"

# Band API
BAND_API_BASE_URL="https://openapi.band.us"

# Shop 기본 URL
NEXT_PUBLIC_SHOP_BASE_URL="http://localhost:3000"

# JWT 인증
JWT_SECRET="your-jwt-secret"

# Toss Payments
TOSS_PAYMENTS_SECRET_KEY="test_sk_xxx"
TOSS_API_URL="https://api.tosspayments.com/v1/payments"
NEXT_PUBLIC_TOSS_MERCHANT_ID=""
NEXT_PUBLIC_TOSS_DASHBOARD_URL=""

# Band Session Helper Extension ID
NEXT_PUBLIC_BAND_EXTENSION_ID=""

# 웹훅
ORDER_WEBHOOK_TYPE=slack
ORDER_WEBHOOK_URL=

# Redis
REDIS_URL=redis://localhost:6379

# 밴드 세션 쿠키 컬럼 암호화 키 (P0-3) — node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BAND_COOKIE_ENC_KEY=YOUR_64_CHAR_HEX_KEY
