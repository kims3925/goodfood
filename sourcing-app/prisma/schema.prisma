// =============================================
// BANDAUTO SOURCING-APP DATABASE SCHEMA
// =============================================
// Purpose: 도매밴드 게시물 수집 → AI 가공 → 소매밴드 발행
// Tech Stack: MySQL 8.0+, Prisma, TypeScript
// Design Principles:
// - 3NF Normalization
// - Soft Delete (deletedAt)
// - Cascade Delete
// - Multi-platform Support (Band, AliExpress)
// - Multi-AI Provider (Gemini, OpenAI)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// AUTHENTICATION DOMAIN
// =============================================

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255) // bcrypt hashed
  name      String?   @db.VarChar(100)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  deletedAt DateTime? @db.Timestamp(0) // Soft Delete

  // Relationships
  sourcingApiConfigs SourcingApiConfig[]
  aiApiConfigs       AiApiConfig[]
  bands              Band[]
  posts              Post[]
  aiAnalyses         AiAnalysis[]
  publishedPosts     PublishedPost[]

  @@index([email])
  @@index([deletedAt])
  @@map("user")
}

// =============================================
// SOURCING PLATFORM API CONFIGURATION
// =============================================

enum SourcingPlatform {
  BAND        // 네이버 밴드
  ALIEXPRESS  // 알리익스프레스
  // 확장 가능: TAOBAO, COUPANG, etc.
}

model SourcingApiConfig {
  id       Int               @id @default(autoincrement())
  userId   Int
  platform SourcingPlatform

  // Common Fields
  apiKey        String?   @db.VarChar(500)
  accessToken   String?   @db.Text // Band: Access Token만 사용 (만료 시 수동 재입력)
  refreshToken  String?   @db.Text // [미사용] 자동 갱신 기능 없음
  tokenExpiry   DateTime? @db.Timestamp(0)

  // Platform-specific metadata (JSON)
  // Band: {} (Access Token만 사용, metadata 불필요)
  // AliExpress: { appSecret, trackingId }
  metadata      Json?     @default("{}") @db.Json

  // Status
  isActive      Boolean   @default(true)
  lastSyncedAt  DateTime? @db.Timestamp(0)

  createdAt     DateTime  @default(now()) @db.Timestamp(0)
  updatedAt     DateTime  @updatedAt @db.Timestamp(0)
  deletedAt     DateTime? @db.Timestamp(0)

  // Relationships
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bands Band[]

  @@unique([userId, platform, deletedAt]) // 사용자당 플랫폼별 1개 (soft delete 고려)
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([deletedAt])
  @@map("sourcing_api_config")
}

// =============================================
// AI PROVIDER API CONFIGURATION
// =============================================

enum AiProvider {
  GEMINI  // Google Gemini
  OPENAI  // OpenAI GPT
  // 확장 가능: CLAUDE, LLAMA, etc.
}

model AiApiConfig {
  id       Int        @id @default(autoincrement())
  userId   Int
  provider AiProvider

  // Common Fields
  apiKey       String  @db.VarChar(500)
  organization String? @db.VarChar(255) // OpenAI organization ID
  model        String  @db.VarChar(100) // "gemini-2.5-flash", "gpt-4o"

  // Configuration (JSON)
  // { temperature: 0.7, maxTokens: 2048, topP: 1.0 }
  config       Json?   @default("{}") @db.Json

  // Status & Usage
  isActive     Boolean   @default(true)
  usageCount   Int       @default(0) // 총 호출 횟수
  lastUsedAt   DateTime? @db.Timestamp(0)

  createdAt    DateTime  @default(now()) @db.Timestamp(0)
  updatedAt    DateTime  @updatedAt @db.Timestamp(0)
  deletedAt    DateTime? @db.Timestamp(0)

  // Relationships
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiAnalyses  AiAnalysis[]

  @@unique([userId, provider, deletedAt]) // 사용자당 제공자별 1개
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@index([deletedAt])
  @@map("ai_api_config")
}

// =============================================
// BAND MANAGEMENT
// =============================================

enum BandType {
  WHOLESALE // 도매밴드 (게시물 수집용)
  RETAIL    // 소매밴드 (게시물 발행용)
}

model Band {
  id          Int      @id @default(autoincrement())
  userId      Int
  apiConfigId Int      // 어느 API 설정으로 연결되었는지

  // Band API Data
  bandKey     String   @db.VarChar(255) // Band Platform unique key
  name        String   @db.VarChar(255)
  type        BandType
  description String?  @db.Text
  coverUrl    String?  @db.VarChar(500)
  memberCount Int      @default(0)

  // Status
  isActive    Boolean  @default(true)
  lastSyncedAt DateTime? @db.Timestamp(0)

  createdAt   DateTime  @default(now()) @db.Timestamp(0)
  updatedAt   DateTime  @updatedAt @db.Timestamp(0)
  deletedAt   DateTime? @db.Timestamp(0)

  // Relationships
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiConfig        SourcingApiConfig @relation(fields: [apiConfigId], references: [id], onDelete: Cascade)

  // 도매밴드: 수집된 게시물
  wholesalePosts   Post[]            @relation("WholesaleBand")

  // 소매밴드: 발행된 게시물
  publishedPosts   PublishedPost[]   @relation("RetailBand")

  @@unique([userId, bandKey, deletedAt])
  @@index([userId])
  @@index([apiConfigId])
  @@index([type])
  @@index([isActive])
  @@index([deletedAt])
  @@map("band")
}

// =============================================
// POST MANAGEMENT (게시물 라이프사이클)
// =============================================

enum PostStatus {
  COLLECTED  // 수집됨 (도매밴드에서 가져옴)
  ANALYZING  // AI 분석 중
  ANALYZED   // AI 분석 완료
  MODIFIED   // 수동 수정됨
  READY      // 발행 준비 완료
  PUBLISHED  // 소매밴드에 발행됨
  FAILED     // 처리 실패
}

model Post {
  id         Int        @id @default(autoincrement())
  userId     Int
  bandId     Int        // 도매밴드 ID (출처)
  externalId String     @db.VarChar(255) // Band API post_key or AliExpress product_id

  // Original Content (수집 원본)
  title           String  @db.VarChar(500)
  content         String  @db.Text
  originalContent String  @db.Text // AI 가공 전 원본 보존

  // Processed Content (AI 가공 or 수동 수정)
  processedTitle   String? @db.VarChar(500)
  processedContent String? @db.Text

  // Product Information (AI 추출)
  productName  String? @db.VarChar(255)
  price        Int?    // 원 단위 (기본 가격)
  category     String? @db.VarChar(100)

  // Price Options (다중 가격 지원, JSON Array)
  // Example: [
  //   { name: "1kg", price: 15000, stock: 100 },
  //   { name: "3kg", price: 40000, stock: 50 }
  // ]
  priceOptions Json?   @default("[]") @db.Json

  // Metadata
  author       String?   @db.VarChar(100)
  publishedAt  DateTime? @db.Timestamp(0) // 원본 게시일

  // Status
  status       PostStatus @default(COLLECTED)

  createdAt    DateTime   @default(now()) @db.Timestamp(0)
  updatedAt    DateTime   @updatedAt @db.Timestamp(0)
  deletedAt    DateTime?  @db.Timestamp(0)

  // Relationships
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBand   Band            @relation("WholesaleBand", fields: [bandId], references: [id], onDelete: Cascade)
  images          PostImage[]
  aiAnalyses      AiAnalysis[]
  publishedPosts  PublishedPost[]

  @@unique([bandId, externalId, deletedAt])
  @@index([userId])
  @@index([bandId])
  @@index([status])
  @@index([createdAt]) // 최신순 조회
  @@index([deletedAt])
  @@index([externalId])
  @@map("post")
}

// =============================================
// POST IMAGES
// =============================================

model PostImage {
  id          Int      @id @default(autoincrement())
  postId      Int

  // Image URLs
  imageUrl    String   @db.VarChar(1000) // 최종 이미지 URL (CDN or 로컬)
  originalUrl String   @db.VarChar(1000) // 원본 이미지 URL (Band API)

  // Image Metadata
  width       Int?
  height      Int?
  fileSize    Int?     // bytes
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now()) @db.Timestamp(0)
  deletedAt   DateTime? @db.Timestamp(0)

  // Relationships
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("post_image")
}

// =============================================
// AI ANALYSIS DOMAIN
// =============================================

enum AiAnalysisType {
  PRODUCT_EXTRACTION // 상품명/가격/카테고리 추출
  CONTENT_GENERATION // 제목/설명 자동 생성
  CONTENT_MODIFICATION // 기존 내용 수정
}

enum AiAnalysisStatus {
  PENDING    // 대기 중
  PROCESSING // 처리 중
  COMPLETED  // 완료
  FAILED     // 실패
}

model AiAnalysis {
  id           Int              @id @default(autoincrement())
  userId       Int
  postId       Int
  configId     Int              // 어느 AI 설정으로 실행되었는지

  // Analysis Request
  analysisType AiAnalysisType
  prompt       String           @db.Text // AI에게 보낸 프롬프트

  // Analysis Result (JSON)
  // Product Extraction: { productName, price, category, priceOptions: [...] }
  // Content Generation: { title, content }
  result       Json?            @default("{}") @db.Json

  // Status
  status       AiAnalysisStatus @default(PENDING)
  errorMessage String?          @db.Text

  // Usage Metrics
  tokensUsed   Int?             // 토큰 사용량
  durationMs   Int?             // 처리 시간 (ms)

  createdAt    DateTime         @default(now()) @db.Timestamp(0)
  completedAt  DateTime?        @db.Timestamp(0)

  // Relationships
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  aiConfig  AiApiConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([configId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_analysis")
}

// =============================================
// PUBLISHED POST (발행 이력)
// =============================================

enum PublishStatus {
  PENDING    // 발행 대기
  PUBLISHING // 발행 중
  PUBLISHED  // 발행 완료
  FAILED     // 발행 실패
}

model PublishedPost {
  id           Int           @id @default(autoincrement())
  userId       Int
  postId       Int           // 원본 게시물 ID
  bandId       Int           // 소매밴드 ID (발행 대상)

  // Band API Response
  externalId   String?       @db.VarChar(255) // Band API에서 반환된 post_key
  publishedUrl String?       @db.VarChar(1000) // 발행된 게시물 URL

  // Status
  status       PublishStatus @default(PENDING)
  errorMessage String?       @db.Text
  retryCount   Int           @default(0)

  publishedAt  DateTime?     @db.Timestamp(0) // 실제 발행 완료 시간
  createdAt    DateTime      @default(now()) @db.Timestamp(0)

  // Relationships
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  retailBand  Band @relation("RetailBand", fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([postId, bandId]) // 같은 게시물을 같은 소매밴드에 중복 발행 방지
  @@index([userId])
  @@index([postId])
  @@index([bandId])
  @@index([status])
  @@index([publishedAt])
  @@map("published_post")
}
