// =============================================
// BANDAUTO SOURCING-APP DATABASE SCHEMA
// =============================================
// Purpose: 도매밴드 게시물 수집 → AI 가공 → 소매밴드 발행
// Tech Stack: MySQL 8.0+, Prisma, TypeScript
// Design Principles:
// - 3NF Normalization
// - Cascade Delete
// - Multi-platform Support (Band, AliExpress)
// - Multi-AI Provider (Gemini, OpenAI)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// AUTHENTICATION DOMAIN
// =============================================

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255) // bcrypt hashed
  name      String?   @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  sourcingApiConfigs SourcingApiConfig[]
  aiApiConfigs       AiApiConfig[]
  wholesaleBands     WholesaleBand[]
  retailBands        RetailBand[]
  posts              Post[]
  products           Product[]
  publishSetting     PublishSetting?

  @@index([email])
  @@map("user")
}

// =============================================
// SOURCING PLATFORM API CONFIGURATION
// =============================================

enum SourcingPlatform {
  BAND        // 네이버 밴드
  ALIEXPRESS  // 알리익스프레스
  // 확장 가능: TAOBAO, COUPANG, etc.
}

model SourcingApiConfig {
  id       Int               @id @default(autoincrement())
  userId   Int               @map("user_id")
  platform SourcingPlatform

  // Common Fields
  apiKey        String?   @map("api_key") @db.VarChar(500)
  accessToken   String?   @map("access_token") @db.Text // Band: Access Token만 사용 (만료 시 수동 재입력)
  refreshToken  String?   @map("refresh_token") @db.Text // [미사용] 자동 갱신 기능 없음
  tokenExpiry   DateTime? @map("token_expiry") @db.Timestamp(0)

  // Platform-specific metadata (JSON)
  // Band: {} (Access Token만 사용, metadata 불필요)
  // AliExpress: { appSecret, trackingId }
  metadata      Json?     @default("{}") @db.Json

  // Status
  isActive      Boolean   @map("is_active") @default(true)
  lastSyncedAt  DateTime? @map("last_synced_at") @db.Timestamp(0)

  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBands WholesaleBand[]
  retailBands    RetailBand[]

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@map("sourcing_api_config")
}

// =============================================
// AI PROVIDER API CONFIGURATION
// =============================================

enum AiProvider {
  GEMINI  // Google Gemini
  OPENAI  // OpenAI GPT
  // 확장 가능: CLAUDE, LLAMA, etc.
}

model AiApiConfig {
  id       Int        @id @default(autoincrement())
  userId   Int        @map("user_id")
  provider AiProvider

  // Common Fields
  apiKey       String  @map("api_key") @db.VarChar(500)
  model        String  @db.VarChar(100) // "gemini-2.5-flash", "gpt-4o"

  // Configuration (JSON)
  // { temperature: 0.7, maxTokens: 2048, topP: 1.0 }
  config       Json?   @default("{}") @db.Json

  // Status & Usage
  isActive     Boolean   @map("is_active") @default(true)
  usageCount   Int       @map("usage_count") @default(0) // 총 호출 횟수
  lastUsedAt   DateTime? @map("last_used_at") @db.Timestamp(0)

  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider]) // 사용자당 제공자별 1개
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("ai_api_config")
}

// =============================================
// WHOLESALE BAND MANAGEMENT (도매밴드)
// =============================================

model WholesaleBand {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  apiConfigId Int      @map("api_config_id") // 어느 API 설정으로 연결되었는지

  // Band API Data
  bandKey      String   @map("band_key") @db.VarChar(255) // Band Platform unique key
  name         String   @db.VarChar(255)
  coverUrl     String?  @map("cover_url") @db.VarChar(500)

  // Status
  isActive     Boolean   @map("is_active") @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiConfig SourcingApiConfig @relation(fields: [apiConfigId], references: [id], onDelete: Cascade)

  // 수집된 게시물
  posts Post[] @relation("WholesaleBand")

  @@unique([userId, bandKey])
  @@index([userId])
  @@index([apiConfigId])
  @@index([isActive])
  @@map("wholesale_band")
}

// =============================================
// RETAIL BAND MANAGEMENT (소매밴드)
// =============================================

model RetailBand {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  apiConfigId Int      @map("api_config_id") // 어느 API 설정으로 연결되었는지

  // Band API Data
  bandKey      String   @map("band_key") @db.VarChar(255) // Band Platform unique key
  name         String   @db.VarChar(255)
  coverUrl     String?  @map("cover_url") @db.VarChar(500)

  // Status
  isActive     Boolean   @map("is_active") @default(true)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiConfig SourcingApiConfig @relation(fields: [apiConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, bandKey])
  @@index([userId])
  @@index([apiConfigId])
  @@index([isActive])
  @@map("retail_band")
}

// =============================================
// POST MANAGEMENT (게시물 라이프사이클)
// =============================================

model Post {
  id              Int    @id @default(autoincrement())
  userId          Int    @map("user_id")
  wholesaleBandId Int    @map("wholesale_band_id") // 도매밴드 ID (출처)
  externalId      String @map("external_id") @db.VarChar(255) // Band API post_key or AliExpress product_id

  // Original Content (수집 원본)
  title           String @db.VarChar(500)
  content         String @db.Text

  // Metadata
  author       String?   @db.VarChar(100)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBand WholesaleBand @relation("WholesaleBand", fields: [wholesaleBandId], references: [id], onDelete: Cascade)
  images        PostImage[]
  comments      PostComment[]
  product       Product?      // 1:1 관계 (하나의 게시물은 최대 1개의 상품)

  @@unique([wholesaleBandId, externalId])
  @@index([userId])
  @@index([wholesaleBandId])
  @@index([createdAt]) // 최신순 조회
  @@index([externalId])
  @@map("post")
}

// =============================================
// POST IMAGES
// =============================================

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")

  // Image Info
  name      String   @db.VarChar(255) // UUID_timestamp.ext
  imageUrl  String   @map("image_url") @db.VarChar(1000) // 상대 경로 (예: /assets/images/uuid_2024-01-01_12-00-00.jpg)

  // Image Metadata
  fileSize  Int?     @map("file_size") // bytes
  sortOrder Int      @map("sort_order") @default(0)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)

  // Relationships
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([sortOrder])
  @@map("post_image")
}

// =============================================
// POST COMMENTS
// =============================================

model PostComment {
  id          Int      @id @default(autoincrement())
  postId      Int      @map("post_id")

  // Band API Data
  author      String   @db.VarChar(100) // 댓글 작성자
  content     String   @db.Text // 댓글 내용

  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
  @@map("post_comment")
}

// =============================================
// PRODUCT MANAGEMENT (상품 관리)
// =============================================

enum ProductStatus {
  DRAFT      // 임시저장
  ACTIVE     // 판매중
  INACTIVE   // 판매중지
  SOLDOUT    // 품절
}

model Product {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id") // 생성한 사용자
  postId       Int           @unique @map("post_id") // 게시물 ID (1:1 관계)

  // Basic Info
  name         String        @db.VarChar(500)
  description  String?       @db.Text
  status       ProductStatus @default(DRAFT)

  // Images (post_image 재사용)
  thumbnailUrl String?       @map("thumbnail_url") @db.VarChar(1000) // 첫번째 post_image URL 캐싱

  // Category
  categoryId   String?       @map("category_id") @db.VarChar(100)

  // Pricing
  currency       String  @default("KRW") @db.VarChar(10)
  price          Int?    // 판매가
  wholesalePrice Int?    @map("wholesale_price") // 도매가

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  post     Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  variants ProductVariant[]
  options  ProductOption[]

  @@index([userId])
  @@index([postId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
  @@map("product")
}

model ProductVariant {
  id            Int       @id @default(autoincrement())
  productId     Int       @map("product_id")

  // Variant Info
  sku           String?   @db.VarChar(100)
  optionSummary String?   @map("option_summary") @db.VarChar(500) // "색상:빨강, 사이즈:L"

  // Pricing & Stock
  price          Int   // 판매가
  wholesalePrice Int?  @map("wholesale_price") // 도매가
  stock          Int   @default(0)

  // Additional Info
  weight  Float?  // kg
  barcode String? @db.VarChar(50)

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@map("product_variant")
}

model ProductOption {
  id        Int    @id @default(autoincrement())
  productId Int    @map("product_id")

  // Option Info
  groupName String @map("group_name") @db.VarChar(100) // "색상", "사이즈"
  value     String @db.VarChar(200) // "빨강", "파랑", "L", "XL"
  sortOrder Int    @map("sort_order") @default(0)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  // Relationships
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([groupName])
  @@map("product_option")
}

// =============================================
// PUBLISH SETTINGS (발행 설정)
// =============================================

model PublishSetting {
  id                Int      @id @default(autoincrement())
  userId            Int      @unique @map("user_id") // 사용자당 1개

  // 주문서 설정
  orderFormUrl      String?  @map("order_form_url") @db.VarChar(1000) // 주문서 URL
  additionalComment String?  @map("additional_comment") @db.Text // 추가 안내 문구

  // 자동 발행 설정
  autoPush          Boolean  @map("auto_push") @default(false)

  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("publish_setting")
}
