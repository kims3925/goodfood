// =============================================
// BANDAUTO SOURCING-APP DATABASE SCHEMA
// =============================================
// Purpose: 도매밴드 게시물 수집 → AI 가공 → 소매밴드 발행
// Tech Stack: MySQL 8.0+, Prisma, TypeScript
// Design Principles:
// - 3NF Normalization
// - Soft Delete (deletedAt)
// - Cascade Delete
// - Multi-platform Support (Band, AliExpress)
// - Multi-AI Provider (Gemini, OpenAI)
// =============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// AUTHENTICATION DOMAIN
// =============================================

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique @db.VarChar(255)
  password  String    @db.VarChar(255) // bcrypt hashed
  name      String?   @db.VarChar(100)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  deletedAt DateTime? @db.Timestamp(0) // Soft Delete

  // Relationships
  sourcingApiConfigs SourcingApiConfig[]
  aiApiConfigs       AiApiConfig[]
  wholesaleBands     WholesaleBand[]
  retailBands        RetailBand[]
  posts              Post[]
  aiAnalyses         AiAnalysis[]

  @@index([email])
  @@index([deletedAt])
  @@map("user")
}

// =============================================
// SOURCING PLATFORM API CONFIGURATION
// =============================================

enum SourcingPlatform {
  BAND        // 네이버 밴드
  ALIEXPRESS  // 알리익스프레스
  // 확장 가능: TAOBAO, COUPANG, etc.
}

model SourcingApiConfig {
  id       Int               @id @default(autoincrement())
  userId   Int
  platform SourcingPlatform

  // Common Fields
  apiKey        String?   @db.VarChar(500)
  accessToken   String?   @db.Text // Band: Access Token만 사용 (만료 시 수동 재입력)
  refreshToken  String?   @db.Text // [미사용] 자동 갱신 기능 없음
  tokenExpiry   DateTime? @db.Timestamp(0)

  // Platform-specific metadata (JSON)
  // Band: {} (Access Token만 사용, metadata 불필요)
  // AliExpress: { appSecret, trackingId }
  metadata      Json?     @default("{}") @db.Json

  // Status
  isActive      Boolean   @default(true)
  lastSyncedAt  DateTime? @db.Timestamp(0)

  createdAt     DateTime  @default(now()) @db.Timestamp(0)
  updatedAt     DateTime  @updatedAt @db.Timestamp(0)
  deletedAt     DateTime? @db.Timestamp(0)

  // Relationships
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBands WholesaleBand[]
  retailBands    RetailBand[]

  @@unique([userId, platform, deletedAt]) // 사용자당 플랫폼별 1개 (soft delete 고려)
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@index([deletedAt])
  @@map("sourcing_api_config")
}

// =============================================
// AI PROVIDER API CONFIGURATION
// =============================================

enum AiProvider {
  GEMINI  // Google Gemini
  OPENAI  // OpenAI GPT
  // 확장 가능: CLAUDE, LLAMA, etc.
}

model AiApiConfig {
  id       Int        @id @default(autoincrement())
  userId   Int
  provider AiProvider

  // Common Fields
  apiKey       String  @db.VarChar(500)
  organization String? @db.VarChar(255) // OpenAI organization ID
  model        String  @db.VarChar(100) // "gemini-2.5-flash", "gpt-4o"

  // Configuration (JSON)
  // { temperature: 0.7, maxTokens: 2048, topP: 1.0 }
  config       Json?   @default("{}") @db.Json

  // Status & Usage
  isActive     Boolean   @default(true)
  usageCount   Int       @default(0) // 총 호출 횟수
  lastUsedAt   DateTime? @db.Timestamp(0)

  createdAt    DateTime  @default(now()) @db.Timestamp(0)
  updatedAt    DateTime  @updatedAt @db.Timestamp(0)
  deletedAt    DateTime? @db.Timestamp(0)

  // Relationships
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiAnalyses  AiAnalysis[]

  @@unique([userId, provider, deletedAt]) // 사용자당 제공자별 1개
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@index([deletedAt])
  @@map("ai_api_config")
}

// =============================================
// WHOLESALE BAND MANAGEMENT (도매밴드)
// =============================================

model WholesaleBand {
  id          Int      @id @default(autoincrement())
  userId      Int
  apiConfigId Int      // 어느 API 설정으로 연결되었는지

  // Band API Data
  bandKey     String   @db.VarChar(255) // Band Platform unique key
  name        String   @db.VarChar(255)
  description String?  @db.Text
  coverUrl    String?  @db.VarChar(500)
  memberCount Int      @default(0)

  // Status
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime? @db.Timestamp(0)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  deletedAt DateTime? @db.Timestamp(0)

  // Relationships
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiConfig SourcingApiConfig @relation(fields: [apiConfigId], references: [id], onDelete: Cascade)

  // 수집된 게시물
  posts Post[] @relation("WholesaleBand")

  @@unique([userId, bandKey, deletedAt])
  @@index([userId])
  @@index([apiConfigId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("wholesale_band")
}

// =============================================
// RETAIL BAND MANAGEMENT (소매밴드)
// =============================================

model RetailBand {
  id          Int      @id @default(autoincrement())
  userId      Int
  apiConfigId Int      // 어느 API 설정으로 연결되었는지

  // Band API Data
  bandKey     String   @db.VarChar(255) // Band Platform unique key
  name        String   @db.VarChar(255)
  description String?  @db.Text
  coverUrl    String?  @db.VarChar(500)
  memberCount Int      @default(0)

  // Status
  isActive     Boolean   @default(true)
  lastSyncedAt DateTime? @db.Timestamp(0)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  deletedAt DateTime? @db.Timestamp(0)

  // Relationships
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  apiConfig SourcingApiConfig @relation(fields: [apiConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, bandKey, deletedAt])
  @@index([userId])
  @@index([apiConfigId])
  @@index([isActive])
  @@index([deletedAt])
  @@map("retail_band")
}

// =============================================
// POST MANAGEMENT (게시물 라이프사이클)
// =============================================

enum PostStatus {
  COLLECTED  // 수집됨 (도매밴드에서 가져옴)
  ANALYZING  // AI 분석 중
  ANALYZED   // AI 분석 완료
  MODIFIED   // 수동 수정됨
  READY      // 발행 준비 완료
  PUBLISHED  // 소매밴드에 발행됨
  FAILED     // 처리 실패
}

model Post {
  id              Int    @id @default(autoincrement())
  userId          Int
  wholesaleBandId Int    // 도매밴드 ID (출처)
  externalId      String @db.VarChar(255) // Band API post_key or AliExpress product_id

  // Original Content (수집 원본)
  title           String @db.VarChar(500)
  content         String @db.Text
  originalContent String @db.Text // AI 가공 전 원본 보존

  // Metadata
  author      String?   @db.VarChar(100)
  publishedAt DateTime? @db.Timestamp(0) // 원본 게시일

  // Status
  status PostStatus @default(COLLECTED)

  createdAt DateTime  @default(now()) @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @db.Timestamp(0)
  deletedAt DateTime? @db.Timestamp(0)

  // Relationships
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBand  WholesaleBand  @relation("WholesaleBand", fields: [wholesaleBandId], references: [id], onDelete: Cascade)
  images         PostImage[]
  comments       PostComment[]
  aiAnalyses     AiAnalysis[]

  @@unique([wholesaleBandId, externalId, deletedAt])
  @@index([userId])
  @@index([wholesaleBandId])
  @@index([status])
  @@index([createdAt]) // 최신순 조회
  @@index([deletedAt])
  @@index([externalId])
  @@map("post")
}

// =============================================
// POST IMAGES
// =============================================

model PostImage {
  id          Int      @id @default(autoincrement())
  postId      Int

  // Image Info
  name        String   @db.VarChar(255) // UUID_timestamp.ext
  imageUrl    String   @db.VarChar(1000) // 상대 경로 (예: /assets/images/uuid_2024-01-01_12-00-00.jpg)

  // Image Metadata
  fileSize    Int?     // bytes
  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now()) @db.Timestamp(0)
  deletedAt   DateTime? @db.Timestamp(0)

  // Relationships
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("post_image")
}

// =============================================
// POST COMMENTS
// =============================================

model PostComment {
  id         Int      @id @default(autoincrement())
  postId     Int

  // Band API Data
  author     String   @db.VarChar(100) // 댓글 작성자
  content    String   @db.Text // 댓글 내용

  // Metadata
  publishedAt DateTime? @db.Timestamp(0) // 댓글 작성일

  createdAt   DateTime @default(now()) @db.Timestamp(0)
  deletedAt   DateTime? @db.Timestamp(0)

  // Relationships
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([deletedAt])
  @@index([createdAt])
  @@map("post_comment")
}

// =============================================
// AI ANALYSIS DOMAIN
// =============================================

enum AiAnalysisType {
  PRODUCT_EXTRACTION // 상품명/가격/카테고리 추출
  CONTENT_GENERATION // 제목/설명 자동 생성
  CONTENT_MODIFICATION // 기존 내용 수정
}

enum AiAnalysisStatus {
  PENDING    // 대기 중
  PROCESSING // 처리 중
  COMPLETED  // 완료
  FAILED     // 실패
}

model AiAnalysis {
  id           Int              @id @default(autoincrement())
  userId       Int
  postId       Int
  configId     Int              // 어느 AI 설정으로 실행되었는지

  // Analysis Request
  analysisType AiAnalysisType
  prompt       String           @db.Text // AI에게 보낸 프롬프트

  // Analysis Result (JSON)
  // Product Extraction: { productName, price, category, priceOptions: [...] }
  // Content Generation: { title, content }
  result       Json?            @default("{}") @db.Json

  // Status
  status       AiAnalysisStatus @default(PENDING)
  errorMessage String?          @db.Text

  // Usage Metrics
  tokensUsed   Int?             // 토큰 사용량
  durationMs   Int?             // 처리 시간 (ms)

  createdAt    DateTime         @default(now()) @db.Timestamp(0)
  completedAt  DateTime?        @db.Timestamp(0)

  // Relationships
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  aiConfig  AiApiConfig   @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([postId])
  @@index([configId])
  @@index([status])
  @@index([createdAt])
  @@map("ai_analysis")
}
