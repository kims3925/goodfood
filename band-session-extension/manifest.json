{
  "manifest_version": 3,
  "name": "Band Session Helper",
  "description": "Band 세션 쿠키를 수집하여 Bandauto 서버로 전송합니다. Band 페이지 방문 시 자동 저장 지원.",
  "version": "1.0.0",
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.band.us/*",
    "*://*.naver.com/*",
    "*://*.abcpharm.net/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Band Session Helper"
  },
  "externally_connectable": {
    "matches": [
      "https://*.abcpharm.net/*",
      "http://localhost:*/*",
      "http://127.0.0.1:*/*"
    ]
  }
}
