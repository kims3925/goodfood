model PricingPolicy {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  channelId   Int      @map("channel_id")
  name        String   @db.VarChar(100)
  description String?  @db.Text
  content     String   @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  // GBand SaaS (2026-05-13): 게시글 차등 마진 (postType별 마진 규칙 JSON)
  tierRules   Json?    @map("tier_rules")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  channel     Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 경영밴드 이원화 정책 (2026-05-28): 소매채널별 차등 적용 모드
  // target이 없는 소매채널로 발행 시는 INHERIT 기본 동작 (기존 정책 그대로) — 하위 호환 보장
  targets     PricingPolicyTarget[]

  @@index([userId])
  @@index([channelId])
  @@map("pricing_policy")
}

// 경영밴드 이원화 정책 (2026-05-28): PricingPolicy ↔ 소매 Channel 매핑.
// applyMode 별 동작:
//   - INHERIT: 도매채널 PricingPolicy.content/tierRules 그대로 상속 (기본값)
//   - ZERO_MARGIN: 마진 없이 도매가 그대로 (판매가=공급가) — 경영비공개밴드/외주밴드 케이스
//   - CUSTOM: customContent 의 별도 마진 규칙 적용 (향후 확장)
// 매칭되는 Target 행이 없으면 INHERIT 기본 동작이라 기존 정책의 하위 호환 보장.
model PricingPolicyTarget {
  id              Int           @id @default(autoincrement())
  pricingPolicyId Int           @map("pricing_policy_id")
  retailChannelId Int           @map("retail_channel_id")
  applyMode       String        @default("INHERIT") @map("apply_mode") @db.VarChar(20)
  customContent   String?       @map("custom_content") @db.Text
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)
  pricingPolicy   PricingPolicy @relation(fields: [pricingPolicyId], references: [id], onDelete: Cascade)
  retailChannel   Channel       @relation("RetailPolicyTargets", fields: [retailChannelId], references: [id], onDelete: Cascade)

  @@unique([pricingPolicyId, retailChannelId])
  @@index([retailChannelId])
  @@map("pricing_policy_target")
}

model AutomationConfig {
  id                            Int        @id @default(autoincrement())
  userId                        Int        @unique @map("user_id")
  isEnabled                     Boolean    @default(false) @map("is_enabled")
  cronExpression                String?    @map("cron_expression") @db.VarChar(500)
  aiProvider                    AiProvider @default(GEMINI) @map("ai_provider")
  lastRunAt                     DateTime?  @map("last_run_at") @db.Timestamp(0)
  nextRunAt                     DateTime?  @map("next_run_at") @db.Timestamp(0)
  createdAt                     DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt                     DateTime   @updatedAt @map("updated_at") @db.Timestamp(0)
  channelIds                    String?    @map("channel_ids") @db.Text
  retailChannelIds              String?    @map("retail_channel_ids") @db.Text
  shopIds                       String?    @map("shop_ids") @db.Text
  pipelineSteps                 String?    @map("pipeline_steps") @db.Text
  collectionLimit               Int        @default(10) @map("collection_limit")
  collectionLimitByChannel      String?    @map("collection_limit_by_channel") @db.Text
  autoPublishLimit              Int        @default(20) @map("auto_publish_limit")
  autoPublishLimitByShop        String?    @map("auto_publish_limit_by_shop") @db.Text
  autoPublishLimitByChannel     String?    @map("auto_publish_limit_by_channel") @db.Text
  // 종합발행(digest) 설정
  digestMode                    String     @default("individual") @map("digest_mode") @db.VarChar(20) // individual | digest | both
  digestProductsPerPost         Int        @default(20) @map("digest_products_per_post")
  digestImagesPerProduct        Int        @default(1) @map("digest_images_per_product") // 1 | 2 | 4
  // 밴드 발행 방식 전체 스위치 (2026-06-07): COMPOSE(AI 본문작성) | CROSSPOST(다른 밴드에 올리기).
  // 저장 시 사용자의 활성 RETAIL 채널 bandPublishMethod 에 일괄 적용. 기본 COMPOSE.
  bandPublishMethod             String     @default("COMPOSE") @map("band_publish_method") @db.VarChar(20)
  // B2B 공급몰 전환 (2026-06-11): 자동 발행 타깃 — SHOP_ONLY(쇼핑몰만) | BAND_ONLY(밴드만) | BOTH(둘 다).
  // 기존 사용자 동작 보존을 위해 기본 BOTH. 도매밴드→쇼핑몰 B2B 파이프라인은 SHOP_ONLY 사용.
  publishTarget                 String     @default("BOTH") @map("publish_target") @db.VarChar(20)
  // B2B 공급몰 전환 Phase 2: 도매가 변동 처리 정책 — NOTIFY_ONLY(알림만) | AUTO_MARGIN(마진율 유지 자동 갱신)
  priceChangePolicy             String     @default("NOTIFY_ONLY") @map("price_change_policy") @db.VarChar(20)
  user                          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
  @@map("automation_config")
}

model WorkflowLog {
  id           Int            @id @default(autoincrement())
  userId       Int            @map("user_id")
  workflowType WorkflowType   @map("workflow_type")
  triggerType  TriggerType    @default(MANUAL) @map("trigger_type")
  status       WorkflowStatus @default(PENDING)
  currentStep  StepType?      @map("current_step")
  startedAt    DateTime       @default(now()) @map("started_at") @db.Timestamp(0)
  completedAt  DateTime?      @map("completed_at") @db.Timestamp(0)
  totalItems   Int            @default(0) @map("total_items")
  successCount Int            @default(0) @map("success_count")
  failedCount  Int            @default(0) @map("failed_count")
  errorMessage String?        @map("error_message") @db.Text
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  steps        WorkflowStepLog[]

  @@index([userId, workflowType, startedAt])
  @@index([status])
  @@index([triggerType])
  @@map("workflow_log")
}

model WorkflowStepLog {
  id             Int         @id @default(autoincrement())
  workflowId     Int         @map("workflow_id")
  stepType       StepType    @map("step_type")
  stepOrder      Int         @map("step_order")
  status         StepStatus  @default(PENDING)
  startedAt      DateTime?   @map("started_at") @db.Timestamp(0)
  completedAt    DateTime?   @map("completed_at") @db.Timestamp(0)
  totalItems     Int         @default(0) @map("total_items")
  processedItems Int         @default(0) @map("processed_items")
  successCount   Int         @default(0) @map("success_count")
  failedCount    Int         @default(0) @map("failed_count")
  details        String?     @db.Text
  errorMessage   String?     @map("error_message") @db.Text
  deletedAt      DateTime?   @map("deleted_at") @db.Timestamp(0)
  workflow       WorkflowLog @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@unique([workflowId, stepType])
  @@index([workflowId])
  @@index([status])
  @@index([deletedAt])
  @@map("workflow_step_log")
}
