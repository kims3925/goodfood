model Product {
  id                 Int               @id @default(autoincrement())
  userId             Int               @map("user_id")
  channelId          Int?              @map("channel_id")
  collectedPostId    Int?              @map("collected_post_id") // 원본 도매 게시물 (발주 텍스트 품명 출처)
  name               String            @db.VarChar(500)
  sourceProductName  String?           @map("source_product_name") @db.VarChar(500) // 도매방 원본 품명 (발주 텍스트용)
  description        String?           @db.Text
  thumbnailUrl       String?           @map("thumbnail_url") @db.VarChar(1000)
  categoryId         String?           @map("category_id") @db.VarChar(100)
  currency           String            @default("KRW") @db.VarChar(10)
  wholesalePrice     Decimal?           @map("wholesale_price") @db.Decimal(12, 2)
  price              Int?
  isActive           Boolean           @default(true) @map("is_active") // 쇼핑몰 노출 여부
  deletedAt          DateTime?         @map("deleted_at") @db.Timestamp(0) // Soft Delete
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  republishedAt      DateTime?         @map("republished_at") @db.Timestamp(0) // 재발행 시점 (product/list 발행상태에 "재발행완료" 표기용)
  lastDigestPublishedAt DateTime?      @map("last_digest_published_at") @db.Timestamp(0) // 마지막 종합발행 시점 (digest UI에 "종합발행 완료" 뱃지)
  shippingFee        Int?              @map("shipping_fee")
  shippingInfo       String?           @map("shipping_info") @db.Text
  bundleMaxQty       Int?              @default(1) @map("bundle_max_qty") // 합배송 최대 수량
  bundleShippingType BundleShippingType @default(NONE) @map("bundle_shipping_type") // 합배송 타입
  channel            Channel?          @relation(fields: [channelId], references: [id])
  collectedPost      CollectedPost?    @relation(fields: [collectedPostId], references: [id], onDelete: SetNull)
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  options            ProductOption[]
  variants           ProductVariant[]
  shopProducts       ShopProduct[]
  channelProducts    ChannelProduct[]
  wishlists          Wishlist[]
  kakaoAdCards       KakaoAdCard[]

  @@index([userId], name: "product_user_id_idx")
  @@index([channelId], name: "product_channel_id_idx")
  @@index([collectedPostId], name: "product_collected_post_id_idx")
  @@index([categoryId], name: "product_category_id_idx")
  @@index([createdAt], name: "product_created_at_idx")
  @@index([deletedAt], name: "product_deleted_at_idx")
  @@map("product")
}

model ProductVariant {
  id              Int              @id @default(autoincrement())
  productId       Int              @map("product_id")
  optionSummary   String?          @map("option_summary") @db.VarChar(500)
  price           Int
  wholesalePrice  Decimal?         @map("wholesale_price") @db.Decimal(12, 2)
  bundleUnit      Int              @default(1) @map("bundle_unit") // 합배송 단위 수 (예: 2박스 옵션이면 2)
  deletedAt       DateTime?        @map("deleted_at") @db.Timestamp(0) // Soft Delete
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamp(0)
  cartItems       CartItem[]
  guestOrderItems GuestOrderItem[]
  orderItems      OrderItem[]
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], name: "product_variant_product_id_idx")
  @@index([deletedAt], name: "product_variant_deleted_at_idx")
  @@map("product_variant")
}

model ProductOption {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  groupName String   @map("group_name") @db.VarChar(100)
  value     String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], name: "product_option_product_id_idx")
  @@index([groupName], name: "product_option_group_name_idx")
  @@map("product_option")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String   @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  fileHash  String?  @map("file_hash") @db.VarChar(64)
  fileName  String?  @map("file_name") @db.VarChar(255)
  fileSize  Int?     @map("file_size")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], name: "product_image_product_id_idx")
  @@index([fileHash], name: "product_image_file_hash_idx")
  @@map("product_image")
}
