// =============================================
// PRODUCT (내부 기준 상품, 마스터 상품)
// 쇼핑몰/소매 밴드에서 사용하는 정제된 상품
// =============================================

model Product {
  id                 Int           @id @default(autoincrement())
  userId             Int           @map("user_id")

  // 원본 CollectedProduct 참조 (source)
  collectedProductId Int?          @map("collected_product_id")

  // Basic Info
  name               String        @db.VarChar(500)
  description        String?       @db.Text

  // Images
  thumbnailUrl       String?       @map("thumbnail_url") @db.VarChar(1000)

  // Category
  categoryId         String?       @map("category_id") @db.VarChar(100)

  // Pricing
  currency           String        @default("KRW") @db.VarChar(10)
  price              Int?

  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedProduct   CollectedProduct? @relation(fields: [collectedProductId], references: [id], onDelete: SetNull)
  variants           ProductVariant[]
  options            ProductOption[]
  publishedProducts  PublishedProduct[]
  wishlists          Wishlist[]

  @@index([userId])
  @@index([collectedProductId])
  @@index([categoryId])
  @@index([createdAt])
  @@map("product")
}

model ProductVariant {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  sku            String?  @db.VarChar(100)
  optionSummary  String?  @map("option_summary") @db.VarChar(500)
  price          Int
  wholesalePrice Int?     @map("wholesale_price")
  stock          Int      @default(0)
  weight         Float?
  barcode        String?  @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  product        Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId])
  @@index([sku])
  @@map("product_variant")
}

model ProductOption {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  groupName String   @map("group_name") @db.VarChar(100)
  value     String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([groupName])
  @@map("product_option")
}
