model Product {
  id                 Int               @id @default(autoincrement())
  userId             Int               @map("user_id")
  channelId          Int?              @map("channel_id")
  name               String            @db.VarChar(500)
  description        String?           @db.Text
  thumbnailUrl       String?           @map("thumbnail_url") @db.VarChar(1000)
  categoryId         String?           @map("category_id") @db.VarChar(100)
  currency           String            @default("KRW") @db.VarChar(10)
  wholesalePrice     Decimal?           @map("wholesale_price") @db.Decimal(12, 2)
  price              Int?
  isActive           Boolean           @default(true) @map("is_active") // 쇼핑몰 노출 여부
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  shippingFee        Int?              @map("shipping_fee")
  shippingInfo       String?           @map("shipping_info") @db.Text
  bundleMaxQty       Int?              @default(1) @map("bundle_max_qty") // 합배송 최대 수량
  bundleShippingType BundleShippingType @default(NONE) @map("bundle_shipping_type") // 합배송 타입
  channel            Channel?          @relation(fields: [channelId], references: [id])
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  images             ProductImage[]
  options            ProductOption[]
  variants           ProductVariant[]
  shopProducts       ShopProduct[]
  channelProducts    ChannelProduct[]
  wishlists          Wishlist[]

  @@index([userId])
  @@index([channelId])
  @@index([categoryId])
  @@index([createdAt])
  @@map("product")
}

model ProductVariant {
  id              Int              @id @default(autoincrement())
  productId       Int              @map("product_id")
  optionSummary   String?          @map("option_summary") @db.VarChar(500)
  price           Int
  wholesalePrice  Decimal?         @map("wholesale_price") @db.Decimal(12, 2)
  bundleUnit      Int              @default(1) @map("bundle_unit") // 합배송 단위 수 (예: 2박스 옵션이면 2)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamp(0)
  cartItems       CartItem[]
  guestOrderItems GuestOrderItem[]
  orderItems      OrderItem[]
  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variant")
}

model ProductOption {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  groupName String   @map("group_name") @db.VarChar(100)
  value     String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([groupName])
  @@map("product_option")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String   @db.VarChar(1000)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  fileHash  String?  @map("file_hash") @db.VarChar(64)
  fileName  String?  @map("file_name") @db.VarChar(255)
  fileSize  Int?     @map("file_size")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([fileHash])
  @@map("product_image")
}
