// =============================================
// ORDER (주문)
// =============================================

model Order {
  id             Int                 @id @default(autoincrement())
  userId         Int                 @map("user_id")
  orderNumber    String              @unique @map("order_number") @db.VarChar(50)
  status         CustomerOrderStatus @default(PENDING)
  recipientName  String              @map("recipient_name") @db.VarChar(100)
  recipientPhone String              @map("recipient_phone") @db.VarChar(20)
  postalCode     String              @map("postal_code") @db.VarChar(10)
  address        String              @db.VarChar(500)
  addressDetail  String?             @map("address_detail") @db.VarChar(500)
  deliveryMemo   String?             @map("delivery_memo") @db.VarChar(500)
  subtotalAmount Decimal             @map("subtotal_amount") @db.Decimal(12, 2)
  shippingFee    Decimal             @default(0.00) @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal             @map("total_amount") @db.Decimal(12, 2)
  orderedAt      DateTime            @default(now()) @map("ordered_at") @db.Timestamp(0)
  paidAt         DateTime?           @map("paid_at") @db.Timestamp(0)
  shippedAt      DateTime?           @map("shipped_at") @db.Timestamp(0)
  deliveredAt    DateTime?           @map("delivered_at") @db.Timestamp(0)
  cancelledAt    DateTime?           @map("cancelled_at") @db.Timestamp(0)
  cancelReason   String?             @map("cancel_reason") @db.VarChar(500)
  cancelledBy    String?             @map("cancelled_by") @db.VarChar(20)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamp(0)
  user           User                @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payment        Payment?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@index([orderedAt])
  @@index([userId, status])
  @@map("order")
}

model OrderItem {
  id                 Int              @id @default(autoincrement())
  orderId            Int              @map("order_id")
  publishedProductId Int              @map("published_product_id")
  variantId          Int?             @map("variant_id")
  productName        String           @map("product_name") @db.VarChar(500)
  optionSummary      String?          @map("option_summary") @db.VarChar(500)
  thumbnailUrl       String?          @map("thumbnail_url") @db.VarChar(1000)
  quantity           Int
  unitPrice          Decimal          @map("unit_price") @db.Decimal(10, 2)
  totalPrice         Decimal          @map("total_price") @db.Decimal(12, 2)
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  order              Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  publishedProduct   PublishedProduct @relation(fields: [publishedProductId], references: [id])
  variant            ProductVariant?  @relation(fields: [variantId], references: [id])
  review             Review?

  @@index([orderId])
  @@index([publishedProductId])
  @@index([variantId])
  @@map("order_item")
}

// =============================================
// ORDER TEST (웹훅 주문 - 구글폼 등)
// =============================================

model OrderTest {
  id                 Int               @id @default(autoincrement())
  userId             Int               @map("user_id")
  publishedProductId Int?              @map("published_product_id")
  productName        String            @map("product_name") @db.VarChar(500)
  quantity           Int               @default(1)
  unitPrice          Int?              @map("unit_price")
  totalPrice         Int?              @map("total_price")
  customerName       String            @map("customer_name") @db.VarChar(100)
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  publishedProduct   PublishedProduct? @relation(fields: [publishedProductId], references: [id])
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([publishedProductId])
  @@index([productName])
  @@index([customerName])
  @@map("order_test")
}
