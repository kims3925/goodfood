model Order {
  id              Int                 @id @default(autoincrement())
  userId          Int                 @map("user_id")
  orderNumber     String              @unique @map("order_number") @db.VarChar(50)
  status          CustomerOrderStatus @default(PENDING)
  subtotalAmount  Decimal             @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount  Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(12, 2)
  orderedAt       DateTime            @default(now()) @map("ordered_at") @db.Timestamp(0)
  paidAt          DateTime?           @map("paid_at") @db.Timestamp(0)
  preparingAt     DateTime?           @map("preparing_at") @db.Timestamp(0)
  shippedAt       DateTime?           @map("shipped_at") @db.Timestamp(0)
  deliveredAt     DateTime?           @map("delivered_at") @db.Timestamp(0)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamp(0)
  cancelReason    String?             @map("cancel_reason") @db.VarChar(500)
  cancelledBy     String?             @map("cancelled_by") @db.VarChar(20)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamp(0)
  shopId                Int?                  @map("shop_id")
  // GBand SaaS (2026-05-13): 주문 출처 추적 (SHOP/CHAT/KAKAO/MANUAL)
  source                OrderSource           @default(SHOP) @map("source")
  wholesaleOrderStatus  WholesaleOrderStatus? @map("wholesale_order_status")
  wholesaleChannelId    Int?                  @map("wholesale_channel_id")
  wholesaleOrderedAt    DateTime?             @map("wholesale_ordered_at") @db.Timestamp(0)
  // BandAuto SaaS Phase 4 — 주문 발생 경로 (외부주문/AI 챗 자동변환)
  externalKind          ExternalOrderKind?    @map("external_kind")
  externalMemo          String?               @map("external_memo") @db.Text
  // 관리자 메모 (2026-05-21) — 주문 상세에서 운영자가 자유 기입. 고객엔 노출 X.
  adminMemo             String?               @map("admin_memo") @db.Text
  adminMemoUpdatedAt    DateTime?             @map("admin_memo_updated_at") @db.Timestamp(0)
  // B2B 공급몰 전환 Phase 3 (2026-06-11): RETAIL(소매, 기본) | B2B(공급가 주문) | B2B_API(오픈 API 발주)
  orderType             String                @default("RETAIL") @map("order_type") @db.VarChar(20)
  shop                  Shop?                 @relation(fields: [shopId], references: [id])
  wholesaleChannel      Channel?              @relation("OrderWholesaleChannel", fields: [wholesaleChannelId], references: [id])
  user                  User                  @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  payment               Payment?
  shippingAddress       ShippingAddress?
  refundAccount         RefundAccount?
  // SNSAUTO Lite Manager — 실시간 주문 알림 이벤트
  events                OrderEvent[]

  @@index([userId])
  @@index([shopId])
  @@index([orderNumber])
  @@index([status])
  @@index([orderedAt])
  @@index([paidAt])
  @@index([deliveredAt])
  @@index([userId, status])
  @@index([shopId, status])
  @@index([wholesaleOrderStatus])
  @@index([source])
  @@map("order")
}

model OrderItem {
  id             Int             @id @default(autoincrement())
  orderId        Int             @map("order_id")
  shopProductId  Int             @map("shop_product_id")
  variantId      Int?            @map("variant_id")
  productName    String          @map("product_name") @db.VarChar(500)
  optionSummary  String?         @map("option_summary") @db.VarChar(500)
  thumbnailUrl   String?         @map("thumbnail_url") @db.VarChar(1000)
  quantity       Int
  unitPrice      Decimal         @map("unit_price") @db.Decimal(12, 2)
  totalPrice     Decimal         @map("total_price") @db.Decimal(12, 2)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopProduct    ShopProduct     @relation(fields: [shopProductId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  review         Review?

  @@index([orderId])
  @@index([shopProductId])
  @@index([variantId])
  @@map("order_item")
}
