model Channel {
  id                Int              @id @default(autoincrement())
  userId            Int              @map("user_id")
  kind              ChannelKind
  platform          ChannelPlatform
  channelKey        String           @map("channel_key") @db.VarChar(255)
  name              String           @db.VarChar(255)
  coverUrl          String?          @map("cover_url") @db.VarChar(500)
  sortOrder         Int              @default(0) @map("sort_order")
  isActive          Boolean          @default(true) @map("is_active")
  deletedAt         DateTime?        @map("deleted_at") @db.Timestamp(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  shopId            Int?             @map("shop_id")
  bandSessionCookie String?          @map("band_session_cookie") @db.Text
  sessionExpiresAt  DateTime?        @map("session_expires_at")
  orderDeadline     String?          @map("order_deadline") @db.VarChar(50) // 도매방 주문 마감시간 (예: "오후 3시", "14:00")
  // 지침서 Phase 1: 도매방별 취급 가격 범위. 본문에서 추출한 가격이 이 범위 밖이면
  // collection 파이프라인이 게시글을 스킵. null이면 해당 방향 무제한.
  minSourcingPrice  Int?             @map("min_sourcing_price")
  maxSourcingPrice  Int?             @map("max_sourcing_price")
  // GBand SaaS (2026-05-13): 게시글 출처 분류 (자체/외주/공유)
  postType          PostType?        @map("post_type")
  // RETAIL 채널 전용: 발행글 이미지 맨 마지막에 자동 첨부되는 푸터 이미지 URL
  // (예: 밴드 이용 안내사항, 사업자 정보, 교환환불 안내). null이면 첨부 안 함.
  footerImageUrl    String?          @map("footer_image_url") @db.VarChar(1000)
  // 다단계 발행 (bandauto-v2 multi-tier): 이 발행 대상에 적용할 가격 tier.
  // RETAIL(기본)=소매 마진가(기존 동작 그대로). WHOLESALE=소스 도매가 그대로 발행(가족도매방밴드).
  // RETAIL 채널(발행 대상)에만 의미가 있으며, 기본값 RETAIL 이므로 기존 채널은 동작 변화 0.
  publishPriceTier  PriceTier        @default(RETAIL) @map("publish_price_tier")
  // 경영밴드 SaaS 운영플로우 Phase 4.1: 채널별 게시글 만료(자동삭제) 정책.
  // null 이면 전역 기본값(일반 7일 / COM 30일) 사용 — 기존 동작 보존.
  expiryDaysNormal  Int?             @map("expiry_days_normal")  // 일반 카테고리 만료 일수
  expiryDaysCom     Int?             @map("expiry_days_com")     // COM(상시상품) 만료 일수
  autoExpireEnabled Boolean          @default(true) @map("auto_expire_enabled") // 이 채널 자동만료 ON/OFF
  shop              Shop?            @relation(fields: [shopId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  collectedPosts    CollectedPost[]
  pricingPolicies   PricingPolicy[]
  products          Product[]
  channelProducts   ChannelProduct[]
  wholesaleOrders      Order[]        @relation("OrderWholesaleChannel")
  wholesaleGuestOrders GuestOrder[]   @relation("GuestOrderWholesaleChannel")
  // 경영밴드 이원화 정책 (2026-05-28): 이 소매채널을 적용 대상으로 가진 정책들
  retailPolicyTargets  PricingPolicyTarget[] @relation("RetailPolicyTargets")

  @@unique([userId, channelKey])
  @@index([userId])
  @@index([shopId])
  @@index([isActive])
  @@index([deletedAt])
  @@index([kind, platform])
  @@map("channel")
}
