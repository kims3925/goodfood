model Channel {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  kind              ChannelKind
  platform          ChannelPlatform
  channelKey        String             @map("channel_key") @db.VarChar(255)
  name              String             @db.VarChar(255)
  coverUrl          String?            @map("cover_url") @db.VarChar(500)
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  shopId            Int?               @map("shop_id")
  bandSessionCookie String?            @map("band_session_cookie") @db.Text
  sessionExpiresAt  DateTime?          @map("session_expires_at")
  shop              Shop?              @relation(fields: [shopId], references: [id])
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectedPosts    CollectedPost[]
  pricingPolicies   PricingPolicy[]
  products          Product[]
  publishedProducts PublishedProduct[]

  @@unique([userId, channelKey])
  @@index([userId])
  @@index([shopId])
  @@index([isActive])
  @@index([kind, platform])
  @@map("channel")
}
