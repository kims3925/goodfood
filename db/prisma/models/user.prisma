// =============================================
// USER & API CONFIG (사용자 및 API 설정)
// =============================================

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique @db.VarChar(255)
  password           String?             @db.VarChar(255)
  name               String?             @db.VarChar(100)
  phone              String?             @db.VarChar(20)
  role               UserRole            @default(USER)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)

  // Admin relations (sourcing-app)
  aiApiConfigs       AiApiConfig[]
  automationConfig   AutomationConfig?
  posts              Post[]
  pricingPolicies    PricingPolicy[]
  products           Product[]
  productPublishes   ProductPublish[]
  publishHistories   PublishHistory[]
  retailBands        RetailBand[]
  sourcingApiConfigs SourcingApiConfig[]
  wholesaleBands     WholesaleBand[]
  workflowLogs       WorkflowLog[]

  // Customer relations (e-commerce-app)
  addresses          UserAddress[]
  orders             Order[]
  orderTests         OrderTest[]
  sessionCarts       SessionCart[]
  userCoupons        UserCoupon[]
  wishlists          Wishlist[]
  reviews            Review[]
  inquiries          Inquiry[]
  returnRequests     ReturnRequest[]

  // OAuth relations
  oauthAccounts      OAuthAccount[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("user")
}

model SourcingApiConfig {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  platform       SourcingPlatform
  apiKey         String?          @map("api_key") @db.VarChar(500)
  accessToken    String?          @map("access_token") @db.Text
  refreshToken   String?          @map("refresh_token") @db.Text
  tokenExpiry    DateTime?        @map("token_expiry") @db.Timestamp(0)
  metadata       String?          @db.LongText
  isActive       Boolean          @default(true) @map("is_active")
  lastSyncedAt   DateTime?        @map("last_synced_at") @db.Timestamp(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  retailBands    RetailBand[]
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBands WholesaleBand[]

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@map("sourcing_api_config")
}

model AiApiConfig {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  provider   AiProvider
  apiKey     String     @map("api_key") @db.VarChar(500)
  model      String     @db.VarChar(100)
  config     String?    @db.LongText
  isActive   Boolean    @default(true) @map("is_active")
  usageCount Int        @default(0) @map("usage_count")
  lastUsedAt DateTime?  @map("last_used_at") @db.Timestamp(0)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("ai_api_config")
}
