model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique @db.VarChar(255)
  password           String?             @db.VarChar(255)
  name               String?             @db.VarChar(100)
  phone              String?             @db.VarChar(20)
  companyName        String?             @map("company_name") @db.VarChar(200)
  businessNumber     String?             @map("business_number") @db.VarChar(30)
  onlineSalesNumber  String?             @map("online_sales_number") @db.VarChar(50)
  sellerType         String?             @map("seller_type") @db.VarChar(30)
  role               UserRole            @default(USER)
  profileImage       String?             @map("profile_image") @db.VarChar(500)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  marketingAgreedAt  DateTime?           @map("marketing_agreed_at") @db.Timestamp(0)
  privacyAgreedAt    DateTime?           @map("privacy_agreed_at") @db.Timestamp(0)
  signupCompletedAt  DateTime?           @map("signup_completed_at") @db.Timestamp(0)
  tosAgreedAt        DateTime?           @map("tos_agreed_at") @db.Timestamp(0)
  deletedAt          DateTime?           @map("deleted_at") @db.Timestamp(0)
  shopId             Int?                @map("shop_id")
  aiApiConfigs       AiApiConfig[]
  aiPromptConfigs    AiPromptConfig[]
  automationConfig   AutomationConfig?
  carts              Cart[]
  channels           Channel[]
  collectedPosts     CollectedPost[]
  collectedProducts  CollectedProduct[]
  inquiries          Inquiry[]
  orders             Order[]
  pricingPolicies    PricingPolicy[]
  products           Product[]
  shopProducts       ShopProduct[]
  channelProducts    ChannelProduct[]
  returnRequests     ReturnRequest[]
  reviews            Review[]
  settlements        Settlement[]
  shops              Shop[]
  sourcingApiConfigs SourcingApiConfig[]
  registeredShop     Shop?               @relation("ShopCustomers", fields: [shopId], references: [id])
  addresses          UserAddress[]
  userCoupons        UserCoupon[]
  loginLogs          UserLoginLog[]
  wishlists          Wishlist[]
  workflowLogs       WorkflowLog[]
  notifications      Notification[]
  googleSheetConfig  GoogleSheetConfig?
  kakaoAdCards       KakaoAdCard[]
  kakaoAdBatches     KakaoAdBatch[]
  // SaaS 종합계획서 Phase 0 (2026-04-28): 요금제/사용량 추적 백릴레이션
  subscription       UserSubscription?
  usageLogs          UsageLog[]

  // SNSAUTO Lite Manager (2026-05-05): 체험용 7일 프로그램
  // mode='lite' 면 마이샵 + 코칭 + 미션 표시, 'pro' 면 풀 매니저 패널
  // ⚠️ 기본값 'pro' — 기존 admin/manager 사용자가 안전하게 기존 동작 유지.
  //    Lite 신규 가입 플로우에서만 명시적으로 'lite' 설정.
  mode               String              @default("pro") @db.VarChar(20)
  liteStartAt        DateTime?           @map("lite_start_at") @db.Timestamp(0)
  proStartAt         DateTime?           @map("pro_start_at") @db.Timestamp(0)
  // SNSAUTO Shop Publish (2026-05-06): 사용자가 보유 가능한 최대 쇼핑몰 수
  // - lite/lite_band: 1 고정 (강제)
  // - pro: 어드민이 차등 적용 (기본 1, 유료 등급에 따라 증가)
  maxShops           Int                 @default(1) @map("max_shops")
  coachingTips       CoachingTip[]       @relation("UserCoachingTips")
  userMissions       UserMission[]       @relation("UserMissions")

  // SNSAUTO Lite Manager v2 (2026-05-05): 어드민 자동 발행 설정/이력
  liteAutoPublishConfig LiteAutoPublishConfig? @relation("UserLiteAutoPublishConfig")
  liteAutoPublishLogs   LiteAutoPublishLog[]   @relation("UserLiteAutoPublishLogs")

  // AI 채팅 자동응답 (2026-05-06): 4채널 통합 인박스 + 의도별 자동응답
  inboxMessages         InboxMessage[]         @relation("UserInboxMessages")
  autoReplyConfigs      AutoReplyConfig[]      @relation("UserAutoReplyConfigs")

  // AI 쇼핑몰 페이지 빌더 (2026-05-07)
  pageJobs              PageGenerationJob[]    @relation("UserPageJobs")

  // 외부 쇼핑몰 연동 (2026-05-07): 카페24 등 외부몰 소싱+결제
  externalMallConnections ExternalMallConnection[] @relation("UserExternalMallConnections")

  // 밴드공지 1일 N회 (2026-05-15): 인기상품 자동공지 설정
  bandNoticeConfig      BandNoticeConfig?

  // GBand SaaS (2026-05-13): 매니저-스태프 계층 (멀티테넌트 격리)
  managerId Int?   @map("manager_id")
  manager   User?  @relation("ManagerStaff", fields: [managerId], references: [id])
  staff     User[] @relation("ManagerStaff")

  // 밴드 로그인 계정 설정 (2026-06-10): 이 사용자의 발행/삭제 작업에 사용할
  // 밴드 로그인 네이버 ID. 세션 저장 시 이 값과 일치하는지 검증.
  // null 이면 검증 생략 (기존 동작 보존 — 운영자 계정 등).
  bandLoginEmail String? @map("band_login_email") @db.VarChar(255)

  // 확장프로그램 전용 API 키 (2026-06-10): 밴드 세션 저장 전용.
  // 소싱앱 JWT(7일)와 달리 만료 없음 — 재발급 시 교체. null = 미발급.
  extensionApiKey          String?   @unique @map("extension_api_key") @db.VarChar(64)
  extensionApiKeyCreatedAt DateTime? @map("extension_api_key_created_at")

  // B2B 공급몰 전환 Phase 3 (2026-06-11): 사업자 인증 — 승인 시 공급가(wholesalePrice) 노출/주문.
  // 사업자번호/상호는 기존 businessNumber/companyName 필드 재사용.
  b2bStatus       B2bStatus @default(NONE) @map("b2b_status")
  b2bAppliedAt    DateTime? @map("b2b_applied_at") @db.Timestamp(0)
  b2bApprovedAt   DateTime? @map("b2b_approved_at") @db.Timestamp(0)
  b2bRejectReason String?   @map("b2b_reject_reason") @db.VarChar(500)

  @@index([shopId])
  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([mode])
  @@index([managerId]) // 매니저-스태프 조회 (manager_id = ?) 풀스캔 방지
  @@map("user")
}

model UserLoginLog {
  id        Int      @id @default(autoincrement())
  userId    Int?     @map("user_id")
  provider  String   @db.VarChar(50)
  email     String?  @db.VarChar(255)
  ip        String?  @db.VarChar(100)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  success   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
  @@map("user_login_log")
}

model SourcingApiConfig {
  id                Int              @id @default(autoincrement())
  userId            Int              @map("user_id")
  platform          SourcingPlatform
  apiKey            String?          @map("api_key") @db.VarChar(500)
  accessToken       String?          @map("access_token") @db.Text
  refreshToken      String?          @map("refresh_token") @db.Text
  tokenExpiry       DateTime?        @map("token_expiry") @db.Timestamp(0)
  metadata          String?          @db.Text
  isActive          Boolean          @default(true) @map("is_active")
  lastSyncedAt      DateTime?        @map("last_synced_at") @db.Timestamp(0)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  bandCookieExpiry  DateTime?        @map("band_cookie_expiry") @db.Timestamp(0)
  bandSessionCookie String?          @map("band_session_cookie") @db.Text
  // 플랫폼 일괄설정 모드 (2026-06-11, BAND 전용): true 면 본인 accessToken 대신
  // 어드민(ADMIN role)이 등록한 플랫폼 공용 토큰을 사용한다 (settings.service.getEffectiveBandToken).
  useGlobalToken    Boolean          @default(false) @map("use_global_token")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@map("sourcing_api_config")
}

model AiApiConfig {
  id              Int        @id @default(autoincrement())
  userId          Int        @map("user_id")
  provider        AiProvider
  apiKey          String     @map("api_key") @db.VarChar(500)
  model           String     @db.VarChar(100)
  config          String?    @db.Text
  isActive        Boolean    @default(true) @map("is_active")
  usageCount      Int        @default(0) @map("usage_count")
  dailyUsageCount Int        @default(0) @map("daily_usage_count")
  dailyResetDate  DateTime?  @map("daily_reset_date") @db.Date
  lastUsedAt      DateTime?  @map("last_used_at") @db.Timestamp(0)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("ai_api_config")
}

model AiPromptConfig {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  promptType  String   @map("prompt_type") @db.VarChar(50)
  name        String   @db.VarChar(100)
  prompt      String   @db.Text
  description String?  @db.VarChar(500)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, promptType])
  @@index([userId])
  @@index([promptType])
  @@index([isActive])
  @@map("ai_prompt_config")
}

model GoogleSheetConfig {
  id                 Int       @id @default(autoincrement())
  userId             Int       @unique @map("user_id")
  serviceAccountJson String    @map("service_account_json") @db.Text
  spreadsheetId      String    @map("spreadsheet_id") @db.VarChar(255)
  sheetName          String?   @map("sheet_name") @db.VarChar(100)
  isActive           Boolean   @default(true) @map("is_active")
  lastSyncedAt       DateTime? @map("last_synced_at") @db.Timestamp(0)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
  @@map("google_sheet_config")
}
