model Shop {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  subdomain      String         @unique @db.VarChar(63)
  name           String         @db.VarChar(255)
  coverUrl       String?        @map("cover_url") @db.VarChar(500)
  bankName       String?        @map("bank_name") @db.VarChar(50)
  bankAccount    String?        @map("bank_account") @db.VarChar(50)
  accountHolder  String?        @map("account_holder") @db.VarChar(100)
  contactPhone   String?        @map("contact_phone") @db.VarChar(20)
  contactEmail   String?        @map("contact_email") @db.VarChar(255)
  ownerName      String?        @map("owner_name") @db.VarChar(100)
  businessNumber String?        @map("business_number") @db.VarChar(20)
  isActive       Boolean        @default(true) @map("is_active")
  deletedAt      DateTime?      @map("deleted_at") @db.Timestamp(0)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamp(0)
  carts          Cart[]
  channels       Channel[]
  guestOrders    GuestOrder[]
  orders         Order[]
  shopProducts   ShopProduct[]
  settlements    Settlement[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme          ShopTheme?
  customers      User[]         @relation("ShopCustomers")
  notifications  Notification[]

  @@index([userId])
  @@index([subdomain])
  @@index([isActive])
  @@map("shop")
}

model ShopTheme {
  id             Int      @id @default(autoincrement())
  shopId         Int      @unique @map("shop_id")
  primaryColor   String?  @map("primary_color") @db.VarChar(20)
  secondaryColor String?  @map("secondary_color") @db.VarChar(20)
  logoUrl        String?  @map("logo_url") @db.VarChar(500)
  faviconUrl     String?  @map("favicon_url") @db.VarChar(500)
  bannerUrl      String?  @map("banner_url") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("shop_theme")
}
