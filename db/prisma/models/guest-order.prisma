model GuestOrder {
  id              Int                 @id @default(autoincrement())
  shopId          Int?                @map("shop_id")
  orderNumber     String              @unique @map("order_number") @db.VarChar(50)
  status          CustomerOrderStatus @default(PENDING)
  guestName       String              @map("guest_name") @db.VarChar(100)
  guestPhone      String              @map("guest_phone") @db.VarChar(20)
  guestEmail      String?             @map("guest_email") @db.VarChar(200)
  subtotalAmount  Decimal             @map("subtotal_amount") @db.Decimal(12, 2)
  shippingFee     Decimal             @default(0.00) @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount  Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount     Decimal             @map("total_amount") @db.Decimal(12, 2)
  orderedAt       DateTime            @default(now()) @map("ordered_at") @db.Timestamp(0)
  paidAt          DateTime?           @map("paid_at") @db.Timestamp(0)
  preparingAt     DateTime?           @map("preparing_at") @db.Timestamp(0)
  shippedAt       DateTime?           @map("shipped_at") @db.Timestamp(0)
  deliveredAt     DateTime?           @map("delivered_at") @db.Timestamp(0)
  cancelledAt     DateTime?           @map("cancelled_at") @db.Timestamp(0)
  cancelReason    String?             @map("cancel_reason") @db.VarChar(500)
  cancelledBy     String?             @map("cancelled_by") @db.VarChar(20)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamp(0)
  shop            Shop?               @relation(fields: [shopId], references: [id])
  items           GuestOrderItem[]
  payment         GuestPayment?
  shippingAddress ShippingAddress?
  refundAccount   RefundAccount?

  @@index([shopId])
  @@index([orderNumber])
  @@index([status])
  @@index([guestPhone])
  @@index([orderedAt])
  @@map("guest_order")
}

model GuestOrderItem {
  id             Int             @id @default(autoincrement())
  guestOrderId   Int             @map("guest_order_id")
  shopProductId  Int             @map("shop_product_id")
  variantId      Int?            @map("variant_id")
  productName    String          @map("product_name") @db.VarChar(500)
  optionSummary  String?         @map("option_summary") @db.VarChar(500)
  thumbnailUrl   String?         @map("thumbnail_url") @db.VarChar(1000)
  quantity       Int
  unitPrice      Decimal          @map("unit_price") @db.Decimal(12, 2)
  wholesalePrice Decimal?         @map("wholesale_price") @db.Decimal(12, 2) // 주문 시점의 도매가 스냅샷 (마진 계산용)
  totalPrice     Decimal         @map("total_price") @db.Decimal(12, 2)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamp(0)
  guestOrder     GuestOrder      @relation(fields: [guestOrderId], references: [id], onDelete: Cascade)
  shopProduct    ShopProduct     @relation(fields: [shopProductId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([guestOrderId])
  @@index([shopProductId])
  @@index([variantId])
  @@map("guest_order_item")
}

model GuestPayment {
  id                    Int               @id @default(autoincrement())
  guestOrderId          Int               @unique @map("guest_order_id")
  paymentKey            String?           @map("payment_key") @db.VarChar(200)
  tossOrderId           String?           @map("toss_order_id") @db.VarChar(100)
  method                TossPaymentMethod
  status                TossPaymentStatus @default(READY)
  amount                Decimal           @db.Decimal(12, 2)
  virtualAccountNumber  String?           @map("virtual_account_number") @db.VarChar(50)
  virtualAccountBank    String?           @map("virtual_account_bank") @db.VarChar(20)
  virtualAccountDueDate DateTime?         @map("virtual_account_due_date") @db.Timestamp(0)
  cardCompany           String?           @map("card_company") @db.VarChar(50)
  cardNumber            String?           @map("card_number") @db.VarChar(20)
  installmentMonth      Int?              @map("installment_month")
  cancelReason          String?           @map("cancel_reason") @db.VarChar(500)
  cancelledAmount       Decimal?          @map("cancelled_amount") @db.Decimal(12, 2)
  rawResponse           String?           @map("raw_response") @db.LongText
  approvedAt            DateTime?         @map("approved_at") @db.Timestamp(0)
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamp(0)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  guestOrder            GuestOrder        @relation(fields: [guestOrderId], references: [id], onDelete: Cascade)

  @@index([guestOrderId])
  @@index([paymentKey])
  @@index([tossOrderId])
  @@index([status])
  @@map("guest_payment")
}

model GuestReturnRequest {
  id            Int          @id @default(autoincrement())
  guestOrderId  Int          @map("guest_order_id")
  guestName     String       @map("guest_name") @db.VarChar(100)
  guestPhone    String       @map("guest_phone") @db.VarChar(20)
  requestType   ReturnType   @map("request_type")
  reason        String       @db.Text
  reasonDetail  String?      @map("reason_detail") @db.Text
  refundAmount  Decimal      @map("refund_amount") @db.Decimal(12, 2)
  refundMethod  RefundMethod @map("refund_method")
  bankName      String?      @map("bank_name") @db.VarChar(50)
  accountNumber String?      @map("account_number") @db.VarChar(50)
  accountHolder String?      @map("account_holder") @db.VarChar(50)
  status        ReturnStatus @default(REQUESTED)
  images        String?      @db.LongText
  adminMemo     String?      @map("admin_memo") @db.Text
  requestedAt   DateTime     @default(now()) @map("requested_at") @db.Timestamp(0)
  processedAt   DateTime?    @map("processed_at") @db.Timestamp(0)
  completedAt   DateTime?    @map("completed_at") @db.Timestamp(0)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamp(0)

  @@index([guestOrderId])
  @@index([status])
  @@map("guest_return_request")
}
