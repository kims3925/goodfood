// 정산 상태
enum SettlementStatus {
  PENDING   // 대기중
  COMPLETED // 완료
  CANCELLED // 취소
}

// 정산
model Settlement {
  id          Int              @id @default(autoincrement())
  userId      Int              @map("user_id")
  shopId      Int              @map("shop_id")
  periodStart DateTime         @map("period_start") @db.Date
  periodEnd   DateTime         @map("period_end") @db.Date
  totalOrders Int              @default(0) @map("total_orders")
  totalAmount Decimal          @default(0.00) @map("total_amount") @db.Decimal(12, 2)
  status      SettlementStatus @default(PENDING)
  memo        String?          @db.VarChar(500)
  settledAt   DateTime?        @map("settled_at") @db.Timestamp(0)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamp(0)

  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  shop  Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items SettlementItem[]

  @@index([userId])
  @@index([shopId])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([userId, shopId])
  @@map("settlement")
}

// 정산 항목 (정산에 포함된 주문 아이템)
model SettlementItem {
  id           Int      @id @default(autoincrement())
  settlementId Int      @map("settlement_id")
  orderItemId  Int      @map("order_item_id")
  orderId      Int      @map("order_id")
  quantity     Int
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice   Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@unique([settlementId, orderItemId])
  @@index([settlementId])
  @@index([orderItemId])
  @@index([orderId])
  @@map("settlement_item")
}
