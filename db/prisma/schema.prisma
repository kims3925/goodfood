generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MANAGER
  ADMIN
}

enum SourcingPlatform {
  BAND
  ALIEXPRESS
}

enum ChannelKind {
  WHOLESALE
  RETAIL
}

// 다단계 발행 가격 tier (bandauto-v2 multi-tier publish)
// 발행 "대상"의 가격 그룹. RETAIL=소매 마진가(기존), WHOLESALE=소스 도매가 그대로(가족도매방).
// 새 PricingPolicy/PublicationTarget 모델을 도입하지 않고, 발행 대상(Channel)에 tier 플래그만
// 부여하여 현행 단일경로를 fan-out 으로 일반화한다. (지시서 §1·§2 의 현실 매핑)
enum PriceTier {
  WHOLESALE
  RETAIL
}

enum ChannelPlatform {
  BAND
  NAVER_CAFE
  ALIEXPRESS
  SMARTSTORE
  COUPANG
  CUSTOM
  // 외부 쇼핑몰 연동 (2026-05-07)
  CAFE24
  OWNERCLAN
  SHOPIFY
  CUSTOM_API
}

enum AiProvider {
  GEMINI
  OPENAI
  CLAUDE
}

enum WorkflowType {
  COLLECT
  TRANSFORM
  PUBLISH
  FULL_PIPELINE
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
  WAITING_SESSION    // 세션 만료로 대기 중 (프론트엔드에서 세션 저장 후 재개)
}

enum TriggerType {
  MANUAL
  SCHEDULED
}

enum StepType {
  COLLECTION
  TRANSFORM
  PRODUCT_CREATE
  PUBLISH
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum CustomerOrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TossPaymentMethod {
  CARD
  VIRTUAL_ACCOUNT
  TRANSFER
  MOBILE
  CULTURE_GIFT
  BOOK_GIFT
  GAME_GIFT
  BANK_TRANSFER
}

enum TossPaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED
  FREE_SHIPPING
}

enum InquiryType {
  PRODUCT
  DELIVERY
  ORDER
  PAYMENT
  RETURN
  EXCHANGE
  GENERAL
}

enum InquiryStatus {
  PENDING
  ANSWERED
}

enum ReturnType {
  CANCEL
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum RefundMethod {
  CREDIT_CARD
  BANK_TRANSFER
  POINTS
}

enum NotificationType {
  // Shop 알림 타입
  ORDER
  CANCEL
  REFUND
  INQUIRY
  SETTLEMENT
  // Sourcing 알림 타입
  COLLECT
  TRANSFORM
  PUBLISH
  ERROR
  INFO
}

// 도매 발주 상태
enum WholesaleOrderStatus {
  PENDING    // 발주 대기
  ORDERED    // 발주 완료 (카톡 등으로 전달)
  CONFIRMED  // 도매처 확인
}

// 합배송 타입
enum BundleShippingType {
  NONE      // 합배송 없음
  INCLUDED  // 배송비 포함형: 소매가에 배송비 포함, 합배송 시 할인
  SEPARATE  // 배송비 별도형: 소매가 + 배송비, 합배송 시 배송비 절약
}

// GBand SaaS (2026-05-13): 게시글 출처 분류 - 채널/정책 차등 마진용
enum PostType {
  SELF        // 자체 발행
  OUTSOURCE   // 외주 발행
  SHARED      // 공유 게시글
}

// GBand SaaS (2026-05-13): 주문 출처 추적
enum OrderSource {
  SHOP    // 쇼핑몰 (기본)
  CHAT    // 밴드 채팅
  KAKAO   // 카카오톡
  MANUAL  // 수동 입력
}

// GBand SaaS Phase 4 (2026-05-13): 외부주문 분류 (소매 vs 도매발주)
enum ExternalOrderKind {
  RETAIL     // 소매주문 (고객에게 받음)
  WHOLESALE  // 도매발주 (도매처에 직접 발주)
}

// B2B 공급몰 전환 Phase 2 (2026-06-11): 원본 도매 게시물 상태
enum SourceStatus {
  ACTIVE
  SOLDOUT       // 품절 키워드 감지
  POST_DELETED  // 원본 게시물 삭제됨
  PRICE_CHANGED
}

// B2B 공급몰 전환 Phase 3 (2026-06-11): B2B 회원(사업자) 인증 상태
enum B2bStatus {
  NONE     // 일반 소매 고객
  PENDING  // 사업자 인증 대기
  APPROVED
  REJECTED
}
