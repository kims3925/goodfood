generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                 @id @default(autoincrement())
  email              String              @unique @db.VarChar(255)
  password           String              @db.VarChar(255)
  name               String?             @db.VarChar(100)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  aiApiConfigs       AiApiConfig[]
  automationConfig   AutomationConfig?
  posts              Post[]
  pricingPolicies    PricingPolicy[]
  products           Product[]
  productPublishes   ProductPublish[]
  publishHistories   PublishHistory[]
  purchaseOrders     PurchaseOrder[]
  retailBands        RetailBand[]
  sourcingApiConfigs SourcingApiConfig[]
  wholesaleBands     WholesaleBand[]
  workflowLogs       WorkflowLog[]

  @@index([email])
  @@map("user")
}

model SourcingApiConfig {
  id             Int              @id @default(autoincrement())
  userId         Int              @map("user_id")
  platform       SourcingPlatform
  apiKey         String?          @map("api_key") @db.VarChar(500)
  accessToken    String?          @map("access_token") @db.Text
  refreshToken   String?          @map("refresh_token") @db.Text
  tokenExpiry    DateTime?        @map("token_expiry") @db.Timestamp(0)
  metadata       String?          @db.LongText
  isActive       Boolean          @default(true) @map("is_active")
  lastSyncedAt   DateTime?        @map("last_synced_at") @db.Timestamp(0)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  retailBands    RetailBand[]
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBands WholesaleBand[]

  @@unique([userId, platform])
  @@index([userId])
  @@index([platform])
  @@index([isActive])
  @@map("sourcing_api_config")
}

model AiApiConfig {
  id         Int        @id @default(autoincrement())
  userId     Int        @map("user_id")
  provider   AiProvider
  apiKey     String     @map("api_key") @db.VarChar(500)
  model      String     @db.VarChar(100)
  config     String?    @db.LongText
  isActive   Boolean    @default(true) @map("is_active")
  usageCount Int        @default(0) @map("usage_count")
  lastUsedAt DateTime?  @map("last_used_at") @db.Timestamp(0)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
  @@index([provider])
  @@index([isActive])
  @@map("ai_api_config")
}

model WholesaleBand {
  id          Int               @id @default(autoincrement())
  userId      Int               @map("user_id")
  apiConfigId Int               @map("api_config_id")
  bandKey     String            @map("band_key") @db.VarChar(255)
  name        String            @db.VarChar(255)
  coverUrl    String?           @map("cover_url") @db.VarChar(500)
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  posts       Post[]            @relation("WholesaleBand")
  apiConfig   SourcingApiConfig @relation(fields: [apiConfigId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bandKey])
  @@index([userId])
  @@index([apiConfigId])
  @@index([isActive])
  @@map("wholesale_band")
}

model RetailBand {
  id               Int               @id @default(autoincrement())
  userId           Int               @map("user_id")
  apiConfigId      Int               @map("api_config_id")
  bandKey          String            @map("band_key") @db.VarChar(255)
  name             String            @db.VarChar(255)
  coverUrl         String?           @map("cover_url") @db.VarChar(500)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  formUrl          String?           @map("form_url") @db.VarChar(500)
  publishHistories PublishHistory[]
  purchaseOrders   PurchaseOrder[]
  apiConfig        SourcingApiConfig @relation(fields: [apiConfigId], references: [id], onDelete: Cascade)
  productPublishes ProductPublish[]
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bandKey])
  @@index([userId])
  @@index([apiConfigId])
  @@index([isActive])
  @@map("retail_band")
}

model Post {
  id              Int           @id @default(autoincrement())
  userId          Int           @map("user_id")
  wholesaleBandId Int           @map("wholesale_band_id")
  externalId      String        @map("external_id") @db.VarChar(255)
  title           String        @db.VarChar(500)
  content         String        @db.Text
  author          String?       @db.VarChar(100)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBand   WholesaleBand @relation("WholesaleBand", fields: [wholesaleBandId], references: [id], onDelete: Cascade)
  comments        PostComment[]
  images          PostImage[]
  product         Product?

  @@unique([wholesaleBandId, externalId])
  @@index([userId])
  @@index([wholesaleBandId])
  @@index([createdAt])
  @@index([externalId])
  @@map("post")
}

model PostImage {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  name      String   @db.VarChar(255)
  imageUrl  String   @map("image_url") @db.VarChar(1000)
  fileSize  Int?     @map("file_size")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([sortOrder])
  @@map("post_image")
}

model PostComment {
  id        Int      @id @default(autoincrement())
  postId    Int      @map("post_id")
  author    String   @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([createdAt])
  @@map("post_comment")
}

// =============================================
// PRODUCT MANAGEMENT (상품 관리)
// =============================================

model Product {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id") // 생성한 사용자
  postId       Int           @unique @map("post_id") // 게시물 ID (1:1 관계)

  // Basic Info
  name         String        @db.VarChar(500)
  description  String?       @db.Text

  // Images (post_image 재사용)
  thumbnailUrl String?       @map("thumbnail_url") @db.VarChar(1000) // 첫번째 post_image URL 캐싱

  // Category
  categoryId   String?       @map("category_id") @db.VarChar(100)

  // Pricing
  currency       String  @default("KRW") @db.VarChar(10)
  price          Int?    // 판매가
  wholesalePrice Int?    @map("wholesale_price") // 도매가

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user                   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  post                   Post             @relation(fields: [postId], references: [id], onDelete: Cascade)
  variants               ProductVariant[]
  options                ProductOption[]
  purchaseOrders         PurchaseOrder[]
  productPublishes       ProductPublish[]
  publishHistories       PublishHistory[]
  // E-Commerce Relations
  cartItems              CartItem[]
  sessionCartItems       SessionCartItem[]
  customerOrderItems     CustomerOrderItem[]

  @@index([userId])
  @@index([postId])
  @@index([categoryId])
  @@index([createdAt])
  @@map("product")
}

model ProductVariant {
  id             Int      @id @default(autoincrement())
  productId      Int      @map("product_id")
  sku            String?  @db.VarChar(100)
  optionSummary  String?  @map("option_summary") @db.VarChar(500)
  price          Int
  wholesalePrice Int?     @map("wholesale_price")
  stock          Int      @default(0)
  weight         Float?
  barcode        String?  @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@map("product_variant")
}

model ProductOption {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  groupName String   @map("group_name") @db.VarChar(100)
  value     String   @db.VarChar(200)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([groupName])
  @@map("product_option")
}

model PricingPolicy {
  id                Int                @id @default(autoincrement())
  userId            Int                @map("user_id")
  name              String             @db.VarChar(100)
  description       String?            @db.Text
  content           String             @db.Text
  isActive          Boolean            @default(true) @map("is_active")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamp(0)
  automationConfigs AutomationConfig[]
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "pricing_policy_user_id_fkey")
  @@map("pricing_policy")
}

model AutomationConfig {
  id                  Int            @id @default(autoincrement())
  userId              Int            @unique @map("user_id")
  isEnabled           Boolean        @default(false) @map("is_enabled")
  cronExpression      String?        @map("cron_expression") @db.VarChar(50)
  collectFromAllBands Boolean        @default(true) @map("collect_from_all_bands")
  wholesaleBandIds    String?        @map("wholesale_band_ids") @db.LongText
  aiProvider          AiProvider     @default(GEMINI) @map("ai_provider")
  pricingPolicyId     Int?           @map("pricing_policy_id")
  autoPublish         Boolean        @default(false) @map("auto_publish")
  retailBandIds       String?        @map("retail_band_ids") @db.LongText
  lastRunAt           DateTime?      @map("last_run_at") @db.Timestamp(0)
  nextRunAt           DateTime?      @map("next_run_at") @db.Timestamp(0)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamp(0)
  pricingPolicy       PricingPolicy? @relation(fields: [pricingPolicyId], references: [id])
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isEnabled])
  @@index([pricingPolicyId], map: "automation_config_pricing_policy_id_fkey")
  @@map("automation_config")
}

model WorkflowLog {
  id           Int            @id @default(autoincrement())
  userId       Int            @map("user_id")
  workflowType WorkflowType   @map("workflow_type")
  status       WorkflowStatus @default(PENDING)
  startedAt    DateTime       @default(now()) @map("started_at") @db.Timestamp(0)
  completedAt  DateTime?      @map("completed_at") @db.Timestamp(0)
  totalItems   Int            @default(0) @map("total_items")
  successCount Int            @default(0) @map("success_count")
  failedCount  Int            @default(0) @map("failed_count")
  details      String?        @db.LongText
  errorMessage String?        @map("error_message") @db.Text
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, workflowType, startedAt])
  @@index([status])
  @@map("workflow_log")
}

// =============================================
// PRODUCT PUBLISH (상품 발행 - 쇼핑몰 표시용)
// =============================================

model ProductPublish {
  id            Int           @id @default(autoincrement())
  userId        Int           @map("user_id")
  productId     Int           @map("product_id")
  retailBandId  Int           @map("retail_band_id")

  // Status
  status        PublishStatus @default(PENDING)

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(0)

  // Relationships
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailBand RetailBand @relation(fields: [retailBandId], references: [id], onDelete: Cascade)

  @@unique([productId, retailBandId]) // 같은 상품을 같은 밴드에 중복 발행 방지
  @@index([userId])
  @@index([productId])
  @@index([retailBandId])
  @@index([status])
  @@map("product_publish")
}

// =============================================
// PUBLISH HISTORY (발행 이력 로그)
// =============================================

enum PublishStatus {
  SUCCESS
  FAILED
  PENDING
}

model PublishHistory {
  id           Int           @id @default(autoincrement())
  userId       Int           @map("user_id")
  productId    Int           @map("product_id")
  retailBandId Int           @map("retail_band_id")
  postKey      String?       @map("post_key") @db.VarChar(255)
  status       PublishStatus @default(PENDING)
  errorMessage String?       @map("error_message") @db.Text
  publishedAt  DateTime      @default(now()) @map("published_at") @db.Timestamp(0)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailBand   RetailBand    @relation(fields: [retailBandId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, retailBandId])
  @@index([userId])
  @@index([productId])
  @@index([retailBandId])
  @@index([status])
  @@index([publishedAt])
  @@map("publish_history")
}

model PurchaseOrder {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  productId    Int?        @map("product_id")
  retailBandId Int?        @map("retail_band_id")
  productName  String      @map("product_name") @db.VarChar(500)
  totalPrice   Int?        @map("total_price")
  customerName String      @map("customer_name") @db.VarChar(100)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamp(0)
  product      Product?    @relation(fields: [productId], references: [id])
  retailBand   RetailBand? @relation(fields: [retailBandId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
  @@index([retailBandId])
  @@index([productName])
  @@index([customerName])
  @@map("purchase_order")
}

model Customer {
  id           Int               @id @default(autoincrement())
  email        String            @unique @db.VarChar(255)
  passwordHash String            @map("password_hash") @db.VarChar(255)
  name         String            @db.VarChar(100)
  phone        String?           @db.VarChar(20)
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  addresses    CustomerAddress[]
  orders       CustomerOrder[]
  sessionCarts SessionCart[]

  @@index([email])
  @@index([phone])
  @@map("customer")
}

model CustomerAddress {
  id             Int      @id @default(autoincrement())
  customerId     Int      @map("customer_id")
  label          String?  @db.VarChar(50)
  recipientName  String   @map("recipient_name") @db.VarChar(100)
  recipientPhone String   @map("recipient_phone") @db.VarChar(20)
  postalCode     String   @map("postal_code") @db.VarChar(10)
  address        String   @db.VarChar(500)
  addressDetail  String?  @map("address_detail") @db.VarChar(500)
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_address")
}

model SessionCart {
  id         Int       @id @default(autoincrement())
  sessionId  String    @unique @map("session_id") @db.VarChar(100)
  customerId Int?      @map("customer_id")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamp(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamp(0)
  customer   Customer? @relation(fields: [customerId], references: [id])

  @@index([sessionId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("session_cart")
}

model SessionCartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int      @default(1)
  priceAt   Int      @map("price_at")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  variantId Int?     @map("variant_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
  @@index([variantId])
  @@map("session_cart_item")
}

model CartItem {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  productId  Int      @map("product_id")
  quantity   Int      @default(1)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(0)
  variantId  Int?     @map("variant_id")
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId, variantId])
  @@index([customerId])
  @@index([productId])
  @@index([variantId])
  @@map("cart_item")
}

model CustomerOrder {
  id             Int                 @id @default(autoincrement())
  customerId     Int                 @map("customer_id")
  orderNumber    String              @unique @map("order_number") @db.VarChar(50)
  status         CustomerOrderStatus @default(PENDING)
  recipientName  String              @map("recipient_name") @db.VarChar(100)
  recipientPhone String              @map("recipient_phone") @db.VarChar(20)
  postalCode     String              @map("postal_code") @db.VarChar(10)
  address        String              @db.VarChar(500)
  addressDetail  String?             @map("address_detail") @db.VarChar(500)
  deliveryMemo   String?             @map("delivery_memo") @db.VarChar(500)
  subtotalAmount Decimal             @map("subtotal_amount") @db.Decimal(12, 2)
  shippingFee    Decimal             @default(0.00) @map("shipping_fee") @db.Decimal(10, 2)
  discountAmount Decimal             @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal             @map("total_amount") @db.Decimal(12, 2)
  orderedAt      DateTime            @default(now()) @map("ordered_at") @db.Timestamp(0)
  paidAt         DateTime?           @map("paid_at") @db.Timestamp(0)
  shippedAt      DateTime?           @map("shipped_at") @db.Timestamp(0)
  deliveredAt    DateTime?           @map("delivered_at") @db.Timestamp(0)
  cancelledAt    DateTime?           @map("cancelled_at") @db.Timestamp(0)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamp(0)
  customer       Customer            @relation(fields: [customerId], references: [id])
  items          CustomerOrderItem[]
  payment        Payment?

  @@index([customerId])
  @@index([orderNumber])
  @@index([status])
  @@index([orderedAt])
  @@index([customerId, status])
  @@map("customer_order")
}

model CustomerOrderItem {
  id            Int           @id @default(autoincrement())
  orderId       Int           @map("order_id")
  productId     Int?          @map("product_id")
  productName   String        @map("product_name") @db.VarChar(500)
  optionSummary String?       @map("option_summary") @db.VarChar(500)
  thumbnailUrl  String?       @map("thumbnail_url") @db.VarChar(1000)
  quantity      Int
  unitPrice     Decimal       @map("unit_price") @db.Decimal(10, 2)
  totalPrice    Decimal       @map("total_price") @db.Decimal(12, 2)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  variantId     Int?          @map("variant_id")
  order         CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("customer_order_item")
}

model Payment {
  id                    Int               @id @default(autoincrement())
  orderId               Int               @unique @map("order_id")
  paymentKey            String            @unique @map("payment_key") @db.VarChar(200)
  tossOrderId           String            @map("toss_order_id") @db.VarChar(100)
  method                TossPaymentMethod
  status                TossPaymentStatus @default(READY)
  amount                Decimal           @db.Decimal(12, 2)
  virtualAccountNumber  String?           @map("virtual_account_number") @db.VarChar(50)
  virtualAccountBank    String?           @map("virtual_account_bank") @db.VarChar(20)
  virtualAccountDueDate DateTime?         @map("virtual_account_due_date") @db.Timestamp(0)
  cardCompany           String?           @map("card_company") @db.VarChar(50)
  cardNumber            String?           @map("card_number") @db.VarChar(20)
  installmentMonth      Int?              @map("installment_month")
  cancelReason          String?           @map("cancel_reason") @db.VarChar(500)
  cancelledAmount       Decimal?          @map("cancelled_amount") @db.Decimal(12, 2)
  rawResponse           String?           @map("raw_response") @db.LongText
  approvedAt            DateTime?         @map("approved_at") @db.Timestamp(0)
  cancelledAt           DateTime?         @map("cancelled_at") @db.Timestamp(0)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamp(0)
  order                 CustomerOrder     @relation(fields: [orderId], references: [id])

  @@index([paymentKey])
  @@index([tossOrderId])
  @@index([status])
  @@index([approvedAt])
  @@map("payment")
}

enum SourcingPlatform {
  BAND
  ALIEXPRESS
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLDOUT
}

enum WorkflowType {
  COLLECT
  TRANSFORM
  PUBLISH
  FULL_PIPELINE
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

