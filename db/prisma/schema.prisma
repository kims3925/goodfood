generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  MANAGER
  ADMIN
}

enum SourcingPlatform {
  BAND
  ALIEXPRESS
}

enum ChannelKind {
  WHOLESALE
  RETAIL
}

enum ChannelPlatform {
  BAND
  NAVER_CAFE
  ALIEXPRESS
  SMARTSTORE
  COUPANG
  CUSTOM
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum WorkflowType {
  COLLECT
  TRANSFORM
  PUBLISH
  FULL_PIPELINE
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
  WAITING_SESSION    // 세션 만료로 대기 중 (프론트엔드에서 세션 저장 후 재개)
}

enum TriggerType {
  MANUAL
  SCHEDULED
}

enum StepType {
  COLLECTION
  TRANSFORM
  PRODUCT_CREATE
  PUBLISH
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum CustomerOrderStatus {
  PENDING
  PAID
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TossPaymentMethod {
  CARD
  VIRTUAL_ACCOUNT
  TRANSFER
  MOBILE
  CULTURE_GIFT
  BOOK_GIFT
  GAME_GIFT
  BANK_TRANSFER
}

enum TossPaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FIXED
  FREE_SHIPPING
}

enum InquiryType {
  PRODUCT
  DELIVERY
  ORDER
  PAYMENT
  RETURN
  EXCHANGE
  GENERAL
}

enum InquiryStatus {
  PENDING
  ANSWERED
}

enum ReturnType {
  CANCEL
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum RefundMethod {
  CREDIT_CARD
  BANK_TRANSFER
  POINTS
}

enum NotificationType {
  // Shop 알림 타입
  ORDER
  CANCEL
  REFUND
  INQUIRY
  SETTLEMENT
  // Sourcing 알림 타입
  COLLECT
  TRANSFORM
  PUBLISH
  ERROR
  INFO
}

// 합배송 타입
enum BundleShippingType {
  NONE      // 합배송 없음
  INCLUDED  // 배송비 포함형: 소매가에 배송비 포함, 합배송 시 할인
  SEPARATE  // 배송비 별도형: 소매가 + 배송비, 합배송 시 배송비 절약
}
