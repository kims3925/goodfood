generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum UserRole {
  USER
  CUSTOMER
  ADMIN
}

enum SourcingPlatform {
  BAND
  ALIEXPRESS
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLDOUT
}

enum WorkflowType {
  COLLECT
  TRANSFORM
  PUBLISH
  FULL_PIPELINE1
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

enum PublishStatus {
  SUCCESS
  FAILED
  PENDING
}

enum CustomerOrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TossPaymentMethod {
  CARD
  VIRTUAL_ACCOUNT
  TRANSFER
  MOBILE
  CULTURE_GIFT
  BOOK_GIFT
  GAME_GIFT
}

enum TossPaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
}

// =============================================
// 정산 관리
// =============================================

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}
