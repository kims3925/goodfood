generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum UserRole {
  USER
  CUSTOMER
  ADMIN
}

enum SourcingPlatform {
  BAND
  ALIEXPRESS
}

enum ChannelKind {
  WHOLESALE   // 소싱/도매 채널
  RETAIL      // 판매/노출 채널
}

enum ChannelPlatform {
  BAND
  NAVER_CAFE
  ALIEXPRESS
  SMARTSTORE
  COUPANG
  SHOP        // 쇼핑몰 (자체 e-commerce)
  CUSTOM      // 그 외 커스텀 채널
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum ProductStatus {
  COLLECTED  // 수집됨 - 활성 상태
  ARCHIVED   // 보관됨 - 비활성 상태
}

// 도매처/발행처 채널 타입 enum 제거됨
// - SourceChannel, PublishChannel 테이블 삭제로 인해 불필요

enum WorkflowType {
  COLLECT
  TRANSFORM
  PUBLISH
  FULL_PIPELINE1
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

enum TriggerType {
  MANUAL
  SCHEDULED
}

enum PublishStatus {
  SUCCESS
  FAILED
  PENDING
}

// PublishType enum 제거됨 - Channel.platform으로 대체

enum CustomerOrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TossPaymentMethod {
  CARD
  VIRTUAL_ACCOUNT
  TRANSFER
  MOBILE
  CULTURE_GIFT
  BOOK_GIFT
  GAME_GIFT
}

enum TossPaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InquiryType {
  PRODUCT
  DELIVERY
  ORDER
  PAYMENT
  RETURN
  EXCHANGE
  GENERAL
}

enum InquiryStatus {
  PENDING
  ANSWERED
}

enum ReturnType {
  CANCEL
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum RefundMethod {
  CREDIT_CARD
  BANK_TRANSFER
  POINTS
}

