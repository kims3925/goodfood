generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum UserRole {
  USER
  CUSTOMER
  ADMIN
}

enum SourcingPlatform {
  BAND
  ALIEXPRESS
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum ProductStatus {
  COLLECTED  // 수집됨 - 활성 상태
  ARCHIVED   // 보관됨 - 비활성 상태
}

// 도매처 타입
enum SourceChannelType {
  WHOLESALE_BAND  // 도매밴드
  ALI             // 알리바바
  TAOBAO          // 타오바오
  DIRECT          // 직접 등록
}

// 발행처 타입
enum PublishChannelType {
  RETAIL_BAND    // 소매밴드
  SHOPPING_MALL  // 자체 쇼핑몰
  SMART_STORE    // 네이버 스마트스토어
  COUPANG        // 쿠팡
}

enum WorkflowType {
  COLLECT
  TRANSFORM
  PUBLISH
  FULL_PIPELINE1
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

enum TriggerType {
  MANUAL
  SCHEDULED
}

enum PublishStatus {
  SUCCESS
  FAILED
  PENDING
}

enum CustomerOrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TossPaymentMethod {
  CARD
  VIRTUAL_ACCOUNT
  TRANSFER
  MOBILE
  CULTURE_GIFT
  BOOK_GIFT
  GAME_GIFT
}

enum TossPaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum InquiryType {
  PRODUCT
  DELIVERY
  ORDER
  PAYMENT
  RETURN
  EXCHANGE
  GENERAL
}

enum InquiryStatus {
  PENDING
  ANSWERED
}

enum ReturnType {
  CANCEL
  RETURN
  EXCHANGE
}

enum ReturnStatus {
  REQUESTED
  REVIEWING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
}

enum RefundMethod {
  CREDIT_CARD
  BANK_TRANSFER
  POINTS
}

