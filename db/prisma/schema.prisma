generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================
// ENUMS
// =============================================

enum UserRole {
  USER
  CUSTOMER
  ADMIN
}

enum SourcingPlatform {
  BAND
  ALIEXPRESS
}

enum AiProvider {
  GEMINI
  OPENAI
}

enum ProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  SOLDOUT
}

enum WorkflowType {
  COLLECT
  TRANSFORM
  PUBLISH
  FULL_PIPELINE
}

enum WorkflowStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  PARTIAL_SUCCESS
}

enum PublishStatus {
  SUCCESS
  FAILED
  PENDING
}

enum CustomerOrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum TossPaymentMethod {
  CARD
  VIRTUAL_ACCOUNT
  TRANSFER
  MOBILE
  CULTURE_GIFT
  BOOK_GIFT
  GAME_GIFT
}

enum TossPaymentStatus {
  READY
  IN_PROGRESS
  WAITING_FOR_DEPOSIT
  DONE
  CANCELED
  PARTIAL_CANCELED
  ABORTED
  EXPIRED
}

// =============================================
// 정산 관리
// =============================================

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Settlement {
  id               Int              @id @default(autoincrement())
  userId           Int              @map("user_id")
  retailBandId     Int              @map("retail_band_id")
  periodStart      DateTime         @map("period_start") @db.Date
  periodEnd        DateTime         @map("period_end") @db.Date
  totalOrders      Int              @default(0) @map("total_orders")
  totalAmount      Int              @default(0) @map("total_amount")
  status           SettlementStatus @default(PENDING)
  memo             String?          @db.Text
  settledAt        DateTime?        @map("settled_at") @db.Timestamp(0)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamp(0)

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailBand       RetailBand       @relation(fields: [retailBandId], references: [id], onDelete: Cascade)
  orders           SettlementOrder[]

  @@unique([userId, retailBandId, periodStart, periodEnd])
  @@index([userId])
  @@index([retailBandId])
  @@index([status])
  @@map("settlement")
}

model SettlementOrder {
  id              Int           @id @default(autoincrement())
  settlementId    Int           @map("settlement_id")
  purchaseOrderId Int           @map("purchase_order_id")
  amount          Int

  settlement      Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([settlementId, purchaseOrderId])
  @@index([settlementId])
  @@index([purchaseOrderId])
  @@map("settlement_order")
}
