generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id               String          @id @default(cuid())
  email            String          @unique
  password         String
  name             String?
  role             String          @default("SUPPLIER") // "ADMIN", "SUPPLIER", "CUSTOMER"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  bandClientId     String?
  bandClientSecret String?
  bandAccessToken  String?
  collectedPosts   CollectedPost[]
  orders           Order[]
  products         Product[]
  sourcingSites    SourcingSite[]
  wholesaleBands   WholesaleBand[]
  carts            Cart[]
  productPages     ProductPage[]
  shop             Shop?
  retailBands      RetailBand[]
  retailSettings   RetailSettings?
  retailPosts      RetailPost[]
}

model Product {
  id                String       @id @default(cuid())
  userId            String
  title             String
  originalPrice     Float
  salePrice         Float
  description       String
  status            String       @default("DRAFT")
  productCode       String?      // 자체상품코드 (예: 0120250904001)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  sourceType        String?
  sourceId          String?
  images            String       @default("[]")
  hookingTitle      String?
  hookingContent    String?
  detailedContent   String?
  productCategory   String?
  shippingFee       Float?
  priceInfo         String?
  specialNotes      String?
  hasDeadline       Boolean      @default(false)
  deadlineInfo      String?
  isAvailable       Boolean      @default(true)
  unavailableReason String?
  wholesaleBandName String?
  author            String?
  originalCreatedAt DateTime?
  order             Int          @default(0) // 상품 순서 (쇼핑몰 목록 정렬용)
  orders            Order[]
  cartItems         CartItem[]
  productPage       ProductPage?
  retailPosts       RetailPost[]
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productCategory])
  @@index([status])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  email     String?
  address   String?
  memo      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  productId       String
  customerId      String
  userId          String
  quantity        Int
  totalAmount     Float
  status          String    @default("PENDING")
  paymentStatus   String    @default("PENDING") // "PENDING", "PAID", "FAILED", "CANCELED"
  shippingAddress String?   // JSON 문자열로 배송지 정보 저장
  customerMemo    String?   // 고객 요청사항
  trackingNumber  String?   // 송장번호
  shippingStatus  String    @default("PREPARING") // "PREPARING", "SHIPPED", "DELIVERED"
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id])
  customer        Customer  @relation(fields: [customerId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
  payments        Payment[]
  refunds         Refund[]

  @@index([productId])
  @@index([customerId])
  @@index([userId])
  @@index([paymentStatus])
  @@index([shippingStatus])
}

model SourcingSite {
  id                String   @id @default(cuid())
  userId            String
  name              String
  type              String
  category          String?
  url               String?
  customsBaseAmount Float?
  shippingCost      Float?
  isActive          Boolean  @default(true)
  bandKey           String?
  bandAccessToken   String?
  apiKey            String?
  secretKey         String?
  sellerId          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model WholesaleBand {
  id              String          @id @default(cuid())
  userId          String
  name            String
  bandKey         String
  description     String?
  memberCount     Int?
  isActive        Boolean         @default(true)
  collectComments Boolean         @default(false)
  pricingPolicy   String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  collectedPosts  CollectedPost[]
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bandKey])
}

model CollectedPost {
  id                String        @id @default(cuid())
  userId            String
  wholesaleBandId   String
  bandPostId        String
  title             String
  content           String
  author            String?
  images            String        @default("[]")
  comments          String        @default("[]")
  policyApplied     Boolean       @default(false)
  priceCalculation  String?
  aiAnalyzed        Boolean       @default(false)
  shippingFee       Float?
  priceInfo         String?
  priceOptions      String        @default("[]")   // JSON array of price options
  shippingPolicy    String?       // 배송 정책 정보
  hookingTitle      String?
  hookingContent    String?
  detailedContent   String?
  productCategory   String        @default("OTHER")
  extractedPrice    Float?        // AI가 추출한 원가
  adjustedPrice     Float?        // 가격정책 적용된 조정가
  aiProcessedAt     DateTime?
  hasDeadline       Boolean       @default(false)
  deadlineInfo      String?
  lastCheckedAt     DateTime?
  isAvailable       Boolean       @default(true)
  unavailableReason String?
  status            String        @default("PENDING")
  isSelected        Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  bandCreatedAt     DateTime
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wholesaleBand     WholesaleBand @relation(fields: [wholesaleBandId], references: [id], onDelete: Cascade)

  @@unique([wholesaleBandId, bandPostId]) // 동일한 밴드에서 동일한 게시물 중복 방지
  @@index([userId])
  @@index([wholesaleBandId])
  @@index([bandPostId])
  @@index([status])
}

// =====================================
// 토스페이먼츠 연동 및 쇼핑몰 관련 모델
// =====================================

model PaymentMethod {
  id        String    @id @default(cuid())
  name      String    // "토스페이먼츠", "스룩페이" 등
  isActive  Boolean   @default(true)
  config    String    @default("{}") // JSON 형태로 API 키, 설정값들 저장
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  payments  Payment[]

  @@index([name])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String        
  paymentKey      String?       // 토스페이먼츠 결제 키
  method          String        // "카드", "계좌이체", "가상계좌" 등
  amount          Int           // 결제 금액 (원)
  status          String        // "READY", "IN_PROGRESS", "DONE", "CANCELED"
  approvedAt      DateTime?
  failReason      String?
  cancelReason    String?
  webhookData     String?       // 웹훅 데이터 JSON 저장
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId String

  @@index([orderId])
  @@index([paymentKey])
  @@index([status])
}

model ProductPage {
  id              String   @id @default(cuid())
  productId       String   @unique
  userId          String
  slug            String   @unique // SEO 친화적 URL (예: "premium-beef-001")
  title           String
  metaDescription String?
  customDomain    String?  // 커스텀 도메인 지원
  isPublished     Boolean  @default(false)
  viewCount       Int      @default(0)
  seoKeywords     String?  // SEO 키워드
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([slug])
  @@index([userId])
  @@index([isPublished])
}

model Cart {
  id        String     @id @default(cuid())
  sessionId String     // 비회원 장바구니 지원을 위한 세션 ID
  userId    String?
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  priceAt   Float    // 장바구니 담을 당시 가격 (가격 변동 대비)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId]) // 같은 장바구니에 같은 상품 중복 방지
  @@index([cartId])
  @@index([productId])
}

model Refund {
  id          String    @id @default(cuid())
  orderId     String
  amount      Int       // 환불 금액 (원)
  reason      String    // 환불 사유
  status      String    // "PENDING", "APPROVED", "REJECTED", "COMPLETED"
  processedAt DateTime?
  adminMemo   String?   // 관리자 메모
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

model ShopSettings {
  id                  String   @id @default(cuid())
  shopName            String   @default("BandAuto 쇼핑몰")
  businessNumber      String?  // 사업자등록번호
  adminEmail          String?
  customerService     String?  // 고객센터 번호
  defaultShippingFee  Float    @default(3000) // 기본 배송비
  freeShippingAmount  Float    @default(30000) // 무료배송 기준 금액
  returnPolicy        String?  // 반품/교환 정책
  privacyPolicy       String?  // 개인정보처리방침
  termsOfService      String?  // 이용약관
  bankAccount         String?  // 입금 계좌
  seoTitle            String?  // 사이트 SEO 타이틀
  seoDescription      String?  // 사이트 SEO 설명
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model DeliveryTracker {
  id             String    @id @default(cuid())
  orderId        String    @unique
  trackingNumber String    
  company        String    // 택배사명
  status         String    // 배송상태
  currentLocation String?  // 현재 위치
  lastUpdated    DateTime?
  history        String    @default("[]") // 배송 히스토리 JSON
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([trackingNumber])
  @@index([status])
}

// =====================================
// 쇼핑몰 관련 모델
// =====================================

model Shop {
  id           String         @id @default(cuid())
  userId       String         @unique // 각 사용자는 하나의 쇼핑몰만 가질 수 있음
  shopUrl      String         @unique // 영문+숫자만, 중복 불가
  shopName     String         // 한글/영문 최대 20자
  noticeTitle  String?        // 공지사항 제목
  noticeContent String?       // 공지사항 내용
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopProducts ShopProduct[]

  @@index([shopUrl])
  @@index([userId])
}

model ShopProduct {
  id                String   @id @default(cuid())
  shopId            String
  productCode       String   // 상품코드
  category          String   // 카테고리
  name              String   // 상품명
  summary           String?  // 상품요약정보
  status            String   @default("ACTIVE") // 판매상태 (ACTIVE, INACTIVE, SOLD_OUT)
  stock             Int      @default(0) // 재고수량
  supplyPrice       Float    // 공급가
  salePrice         Float    // 판매가
  shippingType      String   @default("FREE") // 배송비 타입 (FREE, FIXED)
  shippingFee       Float    @default(0) // 배송비
  shippingUnit      Int      @default(1) // 몇개당 배송비 반복
  hasOptions        Boolean  @default(false) // 옵션여부
  options           String   @default("[]") // 옵션값/공급가/판매가 JSON
  thumbnail         String?  // 상품 썸네일 URL
  detailContent     String?  // 상품상세정보
  taxType           String   @default("TAXABLE") // 과세유형 (TAXABLE, TAX_FREE)
  isPublished       Boolean  @default(false) // 쇼핑몰 노출 여부
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, productCode]) // 같은 쇼핑몰에서 상품코드 중복 방지
  @@index([shopId])
  @@index([status])
  @@index([isPublished])
}

// =====================================
// 소매밴드 관련 모델
// =====================================

model RetailBand {
  id          String       @id @default(cuid())
  userId      String       // 사용자 ID
  bandKey     String       // 밴드 고유 키
  bandName    String       // 밴드명
  description String?      // 밴드 설명
  memberCount Int          @default(0) // 멤버수
  isActive    Boolean      @default(true) // 활성 상태
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailPosts RetailPost[] // 소매밴드 게시물들

  @@unique([userId, bandKey]) // 같은 사용자가 같은 밴드 중복 등록 방지
  @@index([userId])
  @@index([bandKey])
}

model RetailSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique // 사용자별 하나의 설정
  bandClientId       String?  // Band API Client ID
  bandClientSecret   String?  // Band API Client Secret
  bandAccessToken    String?  // Band API Access Token
  autoPostInterval   Int      @default(30) // 포스팅 간격(분)
  maxPostsPerDay     Int      @default(20) // 일일 최대 포스팅 수
  enableAutoPosting  Boolean  @default(false) // 자동 포스팅 활성화
  postingStart       String   @default("09:00") // 포스팅 시작 시간
  postingEnd         String   @default("22:00") // 포스팅 종료 시간
  isLocked           Boolean  @default(false) // 설정 잠금 여부
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RetailPost {
  id            String   @id @default(cuid())
  userId        String   // 사용자 ID
  retailBandId  String   // 소매밴드 ID
  productId     String   // 상품 ID
  bandPostId    String?  // 밴드에서의 게시물 ID
  title         String   // 게시물 제목
  content       String   // 게시물 내용
  images        String   @default("[]") // 이미지 URL들 (JSON)
  price         Float    // 가격
  shippingFee   Float?   // 배송비
  status        String   @default("PUBLISHED") // PUBLISHED, DELETED, FAILED
  viewCount     Int      @default(0) // 조회수
  likeCount     Int      @default(0) // 좋아요 수
  commentCount  Int      @default(0) // 댓글 수
  publishedAt   DateTime @default(now()) // 발행일
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  retailBand    RetailBand @relation(fields: [retailBandId], references: [id], onDelete: Cascade)
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([retailBandId, bandPostId]) // 같은 밴드에서 같은 게시물 중복 방지
  @@index([userId])
  @@index([retailBandId])
  @@index([productId])
  @@index([status])
  @@index([publishedAt])
}
