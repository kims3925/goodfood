{
  "extends": [
    "next/core-web-vitals"
  ],
  "rules": {
    "react/display-name": "off",
    "react-hooks/rules-of-hooks": "warn"
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "parser": "@typescript-eslint/parser",
      "extends": [
        "next/core-web-vitals"
      ]
    },
    {
      "files": ["db/**/*.js", "db/**/*.ts"],
      "env": {
        "node": true,
        "es2021": true
      }
    },
    {
      "files": ["band-session-extension/**/*.js"],
      "env": {
        "browser": true,
        "es2021": true
      }
    }
  ]
}
