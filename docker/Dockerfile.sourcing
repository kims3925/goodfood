# syntax=docker/dockerfile:1

# ============================================
# Sourcing App Dockerfile (Playwright 포함)
# ============================================

# ============================================
# Stage 1: Dependencies
# ============================================
FROM node:20-bookworm AS deps

WORKDIR /app

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*

# pnpm 설치
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# workspace 설정 및 패키지 파일 복사
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY db/package.json ./db/
COPY db/prisma ./db/prisma
COPY shop-app/package.json ./shop-app/
COPY sourcing-app/package.json ./sourcing-app/

# 의존성 설치 (prisma generate는 db postinstall에서 실행)
RUN pnpm install --frozen-lockfile

# ============================================
# Stage 2: Builder
# ============================================
FROM node:20-bookworm AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

# deps 스테이지에서 의존성 복사
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/db/node_modules ./db/node_modules
COPY --from=deps /app/shop-app/node_modules ./shop-app/node_modules
COPY --from=deps /app/sourcing-app/node_modules ./sourcing-app/node_modules

# 소스 전체 복사
COPY . .

# Prisma Client 생성 및 고정 위치로 복사
WORKDIR /app/db
RUN pnpm prisma generate --schema prisma && \
    mkdir -p /app/prisma-client && \
    cp -r $(find /app/node_modules/.pnpm -path "*/@prisma+client@*/node_modules/.prisma" -type d | head -1)/* /app/prisma-client/

# sourcing-app 빌드
WORKDIR /app
RUN pnpm --filter sourcing-app build && \
    mkdir -p /app/sourcing-app/public

# ============================================
# Stage 3: Runner (Playwright 포함)
# ============================================
FROM mcr.microsoft.com/playwright:v1.58.1-noble AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"
ENV APP_NAME=sourcing

# sharp 설치 (이미지 최적화용)
RUN npm install --omit=dev sharp

# Prisma 스키마 및 클라이언트 복사
COPY --from=builder /app/db/prisma ./db/prisma
COPY --from=builder /app/prisma-client ./node_modules/.prisma

# standalone 빌드 결과 복사
COPY --from=builder /app/sourcing-app/.next/standalone ./
COPY --from=builder /app/sourcing-app/.next/static ./sourcing-app/.next/static
COPY --from=builder /app/sourcing-app/public ./sourcing-app/public

# root로 실행 (볼륨 마운트 접근 권한)
EXPOSE 3001

CMD ["node", "sourcing-app/server.js"]
