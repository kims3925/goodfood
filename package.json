{
  "name": "bandauto-monorepo",
  "version": "1.2.0",
  "private": true,
  "workspaces": [
    "db",
    "e-commerce-app",
    "sourcing-app",
    "modules/*",
    "modules/*/domain",
    "modules/*/api"
  ],
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:ecommerce": "cd e-commerce-app && npm run dev",
    "dev:sourcing": "cd sourcing-app && npm run dev",
    "dev:all": "concurrently \"npm run dev:ecommerce\" \"npm run dev:sourcing\"",
    "build": "next build",
    "build:ecommerce": "cd e-commerce-app && npm run build",
    "build:sourcing": "cd sourcing-app && npm run build",
    "build:all": "npm run build:ecommerce && npm run build:sourcing",
    "start": "next start",
    "lint": "next lint",
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:ui": "npx playwright test --ui",
    "test:report": "npx playwright show-report",
    "test:seed": "node -e \"process.env.DATABASE_URL='file:./test.db'; require('./prisma/seed.ts')\"",
    "test:clean": "node -e \"const fs = require('fs'); const path = 'prisma/test.db'; if(fs.existsSync(path)) fs.unlinkSync(path); console.log('테스트 DB 삭제 완료')\"",
    "test:prepare": "npm run test:clean && npm run test:seed",
    "test:safe": "npm run test:prepare && npx playwright test",
    "backup:dev": "node -e \"const fs = require('fs'); const src = 'prisma/dev.db'; const dest = 'prisma/dev.db.backup'; if(fs.existsSync(src)) { fs.copyFileSync(src, dest); console.log('개발 DB 백업 완료: dev.db.backup'); } else { console.log('dev.db 파일을 찾을 수 없습니다.'); }\"",
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.19.0",
    "@tosspayments/payment-sdk": "^1.9.1",
    "@tosspayments/payment-widget-sdk": "^0.12.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.321.0",
    "next": "14.2.3",
    "next-auth": "^4.24.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.9",
    "playwright": "^1.55.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.49.0",
    "redis": "^4.6.12",
    "uuid": "^12.0.0",
    "xlsx": "^0.18.5",
    "zod": "^3.22.4",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/bull": "^4.10.4",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^20.19.11",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.2.3",
    "postcss": "^8.4.33",
    "prisma": "^6.19.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  }
}
