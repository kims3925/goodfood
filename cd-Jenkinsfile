pipeline {
    agent any

    tools {
        nodejs 'NodeJS-24'
    }

    environment {
        PROJECT_PATH = '/home/ubuntu/bandauto'
        NEXTAUTH_SECRET = credentials('nextauth-secret')
        GUEST_TOKEN_SECRET = credentials('guest-secret')
        JWT_SECRET = credentials('jwt-secret')
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                echo 'Checking out source code...'
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                echo 'Installing dependencies...'
                sh 'npm ci --legacy-peer-deps'
            }
        }

        stage('Generate Prisma Client') {
            steps {
                echo 'Generating Prisma client...'
                dir('db') {
                    sh 'npx prisma generate --schema prisma'
                }
            }
        }

        stage('Build Applications') {
            parallel {
                stage('Build shop-app') {
                    steps {
                        echo 'Building shop-app...'
                        sh 'npm run build:shop'
                    }
                }
                stage('Build sourcing-app') {
                    steps {
                        echo 'Building sourcing-app...'
                        sh 'npm run build:sourcing'
                    }
                }
            }
        }

        stage('Deploy') {

            steps {
                echo 'Deploying application...'
                sh """
                    cd ${PROJECT_PATH}

                    echo "=== Starting deployment ==="

                    # Backup .env files before git reset
                    echo ">>> Backing up .env files..."
                    [ -f .env ] && cp .env /tmp/.env.backup || true
                    [ -f db/.env ] && cp db/.env /tmp/.env.db.backup || true
                    [ -f shop-app/.env ] && cp shop-app/.env /tmp/.env.shop.backup || true
                    [ -f shop-app/.env.local ] && cp shop-app/.env.local /tmp/.env.shop.local.backup || true
                    [ -f sourcing-app/.env ] && cp sourcing-app/.env /tmp/.env.sourcing.backup || true
                    [ -f sourcing-app/.env.local ] && cp sourcing-app/.env.local /tmp/.env.sourcing.local.backup || true

                    # Git pull
                    echo ">>> Pulling latest code..."
                    git fetch origin main
                    git reset --hard origin/main

                    # Restore .env files after git reset
                    echo ">>> Restoring .env files..."
                    [ -f /tmp/.env.backup ] && cp /tmp/.env.backup .env || true
                    [ -f /tmp/.env.db.backup ] && cp /tmp/.env.db.backup db/.env || true
                    [ -f /tmp/.env.shop.backup ] && cp /tmp/.env.shop.backup shop-app/.env || true
                    [ -f /tmp/.env.shop.local.backup ] && cp /tmp/.env.shop.local.backup shop-app/.env.local || true
                    [ -f /tmp/.env.sourcing.backup ] && cp /tmp/.env.sourcing.backup sourcing-app/.env || true
                    [ -f /tmp/.env.sourcing.local.backup ] && cp /tmp/.env.sourcing.local.backup sourcing-app/.env.local || true

                    # =============================================
                    # node_modules 자동 복구 로직
                    # =============================================
                    echo ">>> Checking node_modules integrity..."

                    NEED_REINSTALL=false

                    # 1. node_modules가 없으면 재설치 필요
                    if [ ! -d "node_modules" ]; then
                        echo ">>> node_modules not found, will reinstall"
                        NEED_REINSTALL=true
                    fi

                    # 2. package-lock.json이 변경되었으면 재설치 필요
                    if [ -f ".npm-checksum" ]; then
                        OLD_CHECKSUM=\$(cat .npm-checksum)
                        NEW_CHECKSUM=\$(md5sum package-lock.json | cut -d' ' -f1)
                        if [ "\$OLD_CHECKSUM" != "\$NEW_CHECKSUM" ]; then
                            echo ">>> package-lock.json changed, will reinstall"
                            NEED_REINSTALL=true
                        fi
                    else
                        NEED_REINSTALL=true
                    fi

                    # 3. node_modules 손상 체크 (주요 패키지 확인)
                    if [ "\$NEED_REINSTALL" = "false" ]; then
                        for pkg in next react prisma; do
                            if [ ! -d "node_modules/\$pkg" ]; then
                                echo ">>> Missing package: \$pkg, will reinstall"
                                NEED_REINSTALL=true
                                break
                            fi
                        done
                    fi

                    # 재설치 실행
                    if [ "\$NEED_REINSTALL" = "true" ]; then
                        echo ">>> Cleaning and reinstalling dependencies..."
                        rm -rf node_modules
                        npm ci --legacy-peer-deps

                        # 체크섬 저장
                        md5sum package-lock.json | cut -d' ' -f1 > .npm-checksum
                        echo ">>> Dependencies reinstalled successfully"
                    else
                        echo ">>> node_modules is up to date"
                        # 혹시 모를 문제에 대비해 npm ci 시도
                        npm ci --legacy-peer-deps || {
                            echo ">>> npm ci failed, force reinstalling..."
                            rm -rf node_modules
                            npm ci --legacy-peer-deps
                        }
                    fi

                    # Generate Prisma client
                    echo ">>> Generating Prisma client..."
                    cd db
                    npx prisma generate --schema prisma

                    # =============================================
                    # Prisma 마이그레이션 자동 적용
                    # =============================================
                    echo ">>> Checking for pending migrations..."

                    # 마이그레이션 상태 확인 및 적용
                    MIGRATE_STATUS=\$(npx prisma migrate status --schema prisma 2>&1) || true

                    if echo "\$MIGRATE_STATUS" | grep -q "Database schema is up to date"; then
                        echo ">>> Database schema is already up to date"
                    elif echo "\$MIGRATE_STATUS" | grep -q "Following migrations have not yet been applied"; then
                        echo ">>> Pending migrations found. Applying..."
                        npx prisma migrate deploy --schema prisma
                        echo ">>> Migrations applied successfully"
                    else
                        echo ">>> Migration status:"
                        echo "\$MIGRATE_STATUS"
                        # 마이그레이션이 없거나 다른 상태일 경우에도 deploy 시도
                        npx prisma migrate deploy --schema prisma || {
                            echo ">>> Warning: migrate deploy failed, but continuing..."
                        }
                    fi

                    cd ..

                    # Stop specific PM2 processes before cleaning (파일 잠금 해제)
                    echo ">>> Stopping PM2 processes for clean build..."
                    sudo -u ubuntu pm2 stop shop-app sourcing-app shop sourcing 2>/dev/null || true

                    # Verify processes are stopped (최대 10초 대기)
                    for i in 1 2 3 4 5; do
                        if ! sudo -u ubuntu pm2 list | grep -E 'shop|sourcing' | grep -q 'online'; then
                            echo ">>> All target processes stopped"
                            break
                        fi
                        echo ">>> Waiting for processes to stop... (\$i/5)"
                        sleep 2
                    done

                    # Clean npm cache (skip .next deletion due to permission issues)
                    echo ">>> Cleaning caches..."
                    npm cache clean --force || true

                    # Build applications
                    echo ">>> Building applications..."
                    npm run build:shop
                    npm run build:sourcing

                    # Restart PM2
                    echo ">>> Restarting PM2 processes..."
                    sudo -u ubuntu pm2 reload all --update-env

                    # Verify
                    echo ">>> Verifying deployment..."
                    pm2 status

                    echo "=== Deployment completed! ==="
                """
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
        always {
            echo "Build #${env.BUILD_NUMBER} finished with status: ${currentBuild.currentResult}"
            // 빌드 완료 후 워크스페이스 정리 (디스크 공간 확보)
            cleanWs()
        }
    }
}
