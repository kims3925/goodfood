pipeline {
    agent any

    environment {
        PROJECT_PATH = '/home/ubuntu/bandauto'
        DEPLOY_SERVER = '43.200.225.91'
        DEPLOY_USER = 'ubuntu'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    // CI 잡 성공 시에만 CD 파이프라인 트리거
    // 참고: 수동 실행도 가능하지만, CI 실패 시 첫 stage에서 경고 출력
    triggers {
        upstream(upstreamProjects: 'snsauto-ci/main', threshold: hudson.model.Result.SUCCESS)
    }

    stages {
        // CI 성공 여부 확인 (수동 실행 시 경고)
        stage('CI Guard') {
            steps {
                script {
                    // upstream trigger로 실행된 경우 자동으로 CI 성공 보장
                    // 수동 실행 시 경고 메시지 출력
                    if (!currentBuild.getBuildCauses('hudson.model.Cause$UpstreamCause')) {
                        echo '⚠️  WARNING: Manual execution detected.'
                        echo '⚠️  Please ensure CI pipeline passed before deploying.'
                        echo '⚠️  For safety, this pipeline should be triggered by CI success.'
                    } else {
                        echo '✅ Triggered by upstream CI job success.'
                    }
                }
            }
        }

        // Checkout, Install, Prisma Generate 단계 제거
        // - 운영 서버의 Deploy 단계에서 모두 수행하므로 Jenkins 서버에서 중복 실행 불필요
        // - 배포 시간 ~5분 단축

        stage('Deploy') {

            steps {
                echo 'Deploying application...'
                // SSH로 운영 서버에 접속하여 배포 스크립트 실행
                sshagent(['deploy-ssh-key']) {
                    sh '''
                        ssh -o StrictHostKeyChecking=no ${DEPLOY_USER}@${DEPLOY_SERVER} 'bash -s' << 'DEPLOY_EOF'
cd /home/ubuntu/bandauto

echo "=== 배포 시작 ==="

# Backup .env files before git reset
# 보안: 프로젝트 디렉토리 내 숨김 폴더 사용
ENV_BACKUP_DIR="/home/ubuntu/bandauto/.env-backup-$$"
echo ">>> 보안 백업 디렉토리 생성: $ENV_BACKUP_DIR"
mkdir -p "$ENV_BACKUP_DIR"
chmod 700 "$ENV_BACKUP_DIR"

echo ">>> .env 파일 백업 중..."
[ -f .env ] && cp .env "$ENV_BACKUP_DIR/.env.backup" || true
[ -f db/.env ] && cp db/.env "$ENV_BACKUP_DIR/.env.db.backup" || true
[ -f shop-app/.env ] && cp shop-app/.env "$ENV_BACKUP_DIR/.env.shop.backup" || true
[ -f shop-app/.env.local ] && cp shop-app/.env.local "$ENV_BACKUP_DIR/.env.shop.local.backup" || true
[ -f sourcing-app/.env ] && cp sourcing-app/.env "$ENV_BACKUP_DIR/.env.sourcing.backup" || true
[ -f sourcing-app/.env.local ] && cp sourcing-app/.env.local "$ENV_BACKUP_DIR/.env.sourcing.local.backup" || true

# 백업 파일에 엄격한 권한 적용 (소유자만 읽기/쓰기)
chmod 600 "$ENV_BACKUP_DIR"/.env.* 2>/dev/null || true

# Git reset 전에 권한 문제 있는 폴더 정리
# root 권한으로 삭제 (어떤 소유자든 삭제 가능)
echo ">>> git reset 전 문제 디렉토리 정리 중..."
sudo rm -rf db/node_modules 2>/dev/null || true
sudo rm -rf .git/index.lock 2>/dev/null || true

# Git pull
echo ">>> 최신 코드 가져오는 중..."
git fetch origin main
git reset --hard origin/main

# Restore .env files after git reset
echo ">>> .env 파일 복원 중..."
[ -f "$ENV_BACKUP_DIR/.env.backup" ] && cp "$ENV_BACKUP_DIR/.env.backup" .env || true
[ -f "$ENV_BACKUP_DIR/.env.db.backup" ] && cp "$ENV_BACKUP_DIR/.env.db.backup" db/.env || true
[ -f "$ENV_BACKUP_DIR/.env.shop.backup" ] && cp "$ENV_BACKUP_DIR/.env.shop.backup" shop-app/.env || true
[ -f "$ENV_BACKUP_DIR/.env.shop.local.backup" ] && cp "$ENV_BACKUP_DIR/.env.shop.local.backup" shop-app/.env.local || true
[ -f "$ENV_BACKUP_DIR/.env.sourcing.backup" ] && cp "$ENV_BACKUP_DIR/.env.sourcing.backup" sourcing-app/.env || true
[ -f "$ENV_BACKUP_DIR/.env.sourcing.local.backup" ] && cp "$ENV_BACKUP_DIR/.env.sourcing.local.backup" sourcing-app/.env.local || true

# 복원 후 임시 백업 디렉토리 삭제 (민감 정보 노출 방지)
echo ">>> 임시 백업 디렉토리 삭제 중..."
rm -rf "$ENV_BACKUP_DIR"

# =============================================
# node_modules 자동 복구 로직
# =============================================
echo ">>> node_modules 무결성 확인 중..."

NEED_REINSTALL=false

# 1. node_modules가 없으면 재설치 필요
if [ ! -d "node_modules" ]; then
    echo ">>> node_modules 없음, 재설치 예정"
    NEED_REINSTALL=true
fi

# 2. package-lock.json이 변경되었으면 재설치 필요
if [ -f ".npm-checksum" ]; then
    OLD_CHECKSUM=$(cat .npm-checksum)
    NEW_CHECKSUM=$(md5sum package-lock.json | cut -d' ' -f1)
    if [ "$OLD_CHECKSUM" != "$NEW_CHECKSUM" ]; then
        echo ">>> package-lock.json 변경됨, 재설치 예정"
        NEED_REINSTALL=true
    fi
else
    NEED_REINSTALL=true
fi

# 3. node_modules 손상 체크 (주요 패키지 확인)
if [ "$NEED_REINSTALL" = "false" ]; then
    for pkg in next react prisma; do
        if [ ! -d "node_modules/$pkg" ]; then
            echo ">>> 패키지 누락: $pkg, 재설치 예정"
            NEED_REINSTALL=true
            break
        fi
    done
fi

# 재설치 실행
# 삭제: root 권한 (어떤 소유자든 삭제 가능)
# 설치: 현재 ubuntu 유저로 실행 중이므로 ubuntu 소유로 생성됨
if [ "$NEED_REINSTALL" = "true" ]; then
    echo ">>> 의존성 정리 및 재설치 중..."
    sudo rm -rf node_modules || true
    npm ci --legacy-peer-deps

    # 체크섬 저장
    md5sum package-lock.json | cut -d' ' -f1 > .npm-checksum
    echo ">>> ✅ 의존성 재설치 완료"
else
    echo ">>> node_modules 최신 상태"
    # 혹시 모를 문제에 대비해 npm ci 시도
    npm ci --legacy-peer-deps || {
        echo ">>> npm ci 실패, 강제 재설치 중..."
        sudo rm -rf node_modules || true
        npm ci --legacy-peer-deps
    }
fi

# Generate Prisma client
echo ">>> Prisma 클라이언트 생성 중..."
cd db
npx prisma generate --schema prisma

# =============================================
# Prisma 마이그레이션 자동 적용 (안전장치 포함)
# =============================================
echo ">>> 대기 중인 마이그레이션 확인 중..."

# 마이그레이션 상태 확인
MIGRATE_STATUS=$(npx prisma migrate status --schema prisma 2>&1) || true
echo ">>> 현재 마이그레이션 상태:"
echo "$MIGRATE_STATUS"

# 대기 중인 마이그레이션이 있으면 백업 실행
if echo "$MIGRATE_STATUS" | grep -q "Following migrations have not yet been applied"; then
    echo ">>> ⚠️  마이그레이션 적용 전 데이터베이스 백업 중..."
    BACKUP_FILE="/home/ubuntu/bandauto/backups/pre-migration-$(date +%Y%m%d-%H%M%S).sql"
    mkdir -p /home/ubuntu/bandauto/backups

    # .env에서 DB 정보 읽기
    if [ -f "/home/ubuntu/bandauto/db/.env" ]; then
        export $(grep -E '^DATABASE_URL=' /home/ubuntu/bandauto/db/.env | xargs)
        # DATABASE_URL 파싱: mysql://user:pass@host:port/dbname
        DB_USER=$(echo $DATABASE_URL | sed -E 's|mysql://([^:]+):.*|\1|')
        DB_PASS=$(echo $DATABASE_URL | sed -E 's|mysql://[^:]+:([^@]+)@.*|\1|')
        DB_HOST=$(echo $DATABASE_URL | sed -E 's|mysql://[^@]+@([^:/]+).*|\1|')
        DB_NAME=$(echo $DATABASE_URL | sed -E 's|.*/([^?]+).*|\1|')

        if mysqldump -h"$DB_HOST" -u"$DB_USER" -p"$DB_PASS" "$DB_NAME" > "$BACKUP_FILE" 2>/dev/null; then
            echo ">>> ✅ 백업 완료: $BACKUP_FILE"
        else
            echo ">>> ⚠️  백업 실패 - 마이그레이션은 계속 진행"
        fi
    else
        echo ">>> ⚠️  DB 환경파일 없음 - 백업 건너뜀"
    fi
fi

# Failed 마이그레이션 자동 복구
if echo "$MIGRATE_STATUS" | grep -q "failed"; then
    echo ">>> ⚠️  실패한 마이그레이션 감지! 자동 복구 시도 중..."

    # 실패한 마이그레이션 이름 추출
    FAILED_MIGRATION=$(echo "$MIGRATE_STATUS" | grep -oE '[0-9]{14}_[a-z_]+' | head -1)

    if [ -n "$FAILED_MIGRATION" ]; then
        echo ">>> 실패한 마이그레이션 해결 중: $FAILED_MIGRATION"

        # 마이그레이션이 실제로 적용되었는지 확인 후 resolve
        # (DB에 변경이 적용되었으나 _prisma_migrations 테이블만 failed인 경우)
        if npx prisma migrate resolve --applied "$FAILED_MIGRATION" --schema prisma; then
            echo ">>> ✅ 실패한 마이그레이션 '적용됨'으로 해결 완료"
        else
            echo ">>> ❌ 오류: 실패한 마이그레이션을 해결할 수 없습니다!"
            echo ">>> 수동 개입이 필요합니다."
            exit 1
        fi
    fi

    # 다시 상태 확인
    MIGRATE_STATUS=$(npx prisma migrate status --schema prisma 2>&1) || true
    echo ">>> 업데이트된 마이그레이션 상태:"
    echo "$MIGRATE_STATUS"
fi

if echo "$MIGRATE_STATUS" | grep -q "Database schema is up to date"; then
    echo ">>> ✅ 데이터베이스 스키마가 최신 상태입니다"
elif echo "$MIGRATE_STATUS" | grep -q "Following migrations have not yet been applied"; then
    echo ">>> ⚠️  대기 중인 마이그레이션 발견. 적용 중..."

    # 마이그레이션 적용 (실패 시 배포 중단)
    if npx prisma migrate deploy --schema prisma; then
        echo ">>> ✅ 마이그레이션 적용 완료"
    else
        echo ">>> ❌ 오류: 마이그레이션 실패! 배포 중단."
        echo ">>> 마이그레이션 파일과 데이터베이스 상태를 확인하세요."
        exit 1
    fi
elif echo "$MIGRATE_STATUS" | grep -q "drift"; then
    echo ">>> ⚠️  데이터베이스 스키마 drift 감지!"
    echo ">>> 보통 DB에 수동으로 컬럼을 추가했을 때 발생합니다."
    echo ""
    echo ">>> Drift는 배포를 차단하지 않습니다 - Prisma 클라이언트는 이미 생성됨."
    echo ">>> 나중에 drift를 해결하려면 서버에서 다음 명령 중 하나를 실행하세요:"
    echo ">>>   1. npx prisma db pull --schema prisma  (DB에서 스키마 동기화)"
    echo ">>>   2. npx prisma migrate dev --schema prisma  (drift용 마이그레이션 생성)"
    echo ""
    echo ">>> ⚠️  현재 스키마로 배포 계속 진행..."
else
    echo ">>> migrate deploy 시도 중..."
    if npx prisma migrate deploy --schema prisma; then
        echo ">>> ✅ migrate deploy 완료"
    else
        echo ">>> ❌ 오류: migrate deploy 실패! 배포 중단."
        exit 1
    fi
fi

cd ..

# Stop specific PM2 processes before cleaning (파일 잠금 해제)
echo ">>> 클린 빌드를 위해 PM2 프로세스 중지 중..."
pm2 stop shop-app sourcing-app shop sourcing 2>/dev/null || true

# Verify processes are stopped (최대 10초 대기)
for i in 1 2 3 4 5; do
    if ! pm2 list | grep -E 'shop|sourcing' | grep -q 'online'; then
        echo ">>> 모든 대상 프로세스 중지 완료"
        break
    fi
    echo ">>> 프로세스 중지 대기 중... ($i/5)"
    sleep 2
done

# Build applications
echo ">>> 애플리케이션 빌드 중..."
npm run build:shop
npm run build:sourcing

# Restart PM2
echo ">>> PM2 프로세스 재시작 중..."
pm2 reload all --update-env

# Verify
echo ">>> 배포 검증 중..."
pm2 status

echo "=== 배포 완료! ==="
DEPLOY_EOF
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
        always {
            echo "Build #${env.BUILD_NUMBER} finished with status: ${currentBuild.currentResult}"
            // 빌드 완료 후 워크스페이스 정리 (디스크 공간 확보)
            cleanWs()
        }
    }
}
