pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    CI = 'true'
    NEXT_TELEMETRY_DISABLED = '1'
    // 원하면 pnpm 버전 고정 (프로젝트에 맞춰 수정)
    PNPM_VERSION = '9.15.4'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Setup') {
      steps {
        sh '''
          set -eux
          node -v

          corepack --version
          corepack prepare pnpm@${PNPM_VERSION} --activate

          pnpm -v
        '''
      }
    }

    stage('Install') {
      steps {
        sh '''
          set -eux
          pnpm install --frozen-lockfile
        '''
      }
    }

    stage('Lint') {
      steps {
        sh '''
          set -eux
          if pnpm -s run | grep -q "^lint"; then
            pnpm lint
          else
            echo "No lint script. Skip."
          fi
        '''
      }
    }

    stage('Typecheck') {
      steps {
        sh '''
          set -eux
          if pnpm -s run | grep -q "^typecheck"; then
            pnpm typecheck
          else
            echo "No typecheck script. Skip."
          fi
        '''
      }
    }

    stage('Test') {
      steps {
        sh '''
          set -eux
          if pnpm -s run | grep -q "^test"; then
            pnpm test
          else
            echo "No test script. Skip."
          fi
        '''
      }
    }

    stage('Build') {
      steps {
        sh '''
          set -eux
          pnpm build
        '''
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: '**/junit.xml'
      archiveArtifacts artifacts: '.next/**', allowEmptyArchive: true
    }
  }
}
