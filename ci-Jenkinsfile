pipeline {
  agent any

  tools {
    nodejs 'NodeJS-24'
  }

  options {
    timestamps()
    disableConcurrentBuilds()
    // 빌드 보존 정책: 최근 5개만 유지, 7일 이상 된 빌드 삭제
    buildDiscarder(logRotator(numToKeepStr: '5', daysToKeepStr: '7'))
  }

  environment {
    CI = 'true'
    NEXT_TELEMETRY_DISABLED = '1'
    // 브랜치 필터 조건
    SHOULD_BUILD = "${env.BRANCH_NAME ==~ /(main|release-.*)/ || env.CHANGE_ID ? 'true' : 'false'}"
  }

  stages {
    stage('Branch Check') {
      steps {
        script {
          if (env.SHOULD_BUILD != 'true') {
            currentBuild.result = 'SUCCESS'
            currentBuild.description = "건너뜀: ${env.BRANCH_NAME} (main, release-*, PR만 빌드)"
            echo "브랜치 빌드 건너뜀: ${env.BRANCH_NAME}"
          } else {
            echo "브랜치 빌드 시작: ${env.BRANCH_NAME}"
          }
        }
      }
    }

    // stage('Checkout') {
    //   when { environment name: 'SHOULD_BUILD', value: 'true' }
    //   steps {
    //     // 이전 빌드 잔여물 정리 (권한 문제 방지)
    //     sh 'rm -rf sourcing-app/.next shop-app/.next || true'
    //     checkout scm
    //   }
    // }

    stage('Setup') {
      when { environment name: 'SHOULD_BUILD', value: 'true' }
      steps {
        sh '''
          set -eux
          node -v
          npm -v
        '''
      }
    }

    stage('Debug') {
      when { environment name: 'SHOULD_BUILD', value: 'true' }
      steps {
        sh '''
          set -eux
          git rev-parse HEAD
          git log -1 --oneline
          ls -al package.json package-lock.json
          node -e "console.log('pkg nodemailer=', require('./package.json').dependencies?.nodemailer || require('./package.json').devDependencies?.nodemailer)"
          node -e "console.log('lock nodemailer=', require('./package-lock.json').packages?.['']?.dependencies?.nodemailer)"
        '''
      }
    }

    stage('Install') {
      when { environment name: 'SHOULD_BUILD', value: 'true' }
      steps {
        sh '''
          set -eux
          npm ci
        '''
      }
    }

    stage('Generate Prisma Client') {
      when { environment name: 'SHOULD_BUILD', value: 'true' }
      steps {
        sh '''
          set -eux
          cd db
          npx prisma generate --schema prisma
          cd ..
        '''
      }
    }

    stage('Lint') {
      when { environment name: 'SHOULD_BUILD', value: 'true' }
      steps {
        sh '''
          set -eux
          if npm run | grep -q " lint"; then
            npm run lint
          else
            echo "lint 스크립트 없음. 건너뜀."
          fi
        '''
      }
    }

    stage('Typecheck') {
      when { environment name: 'SHOULD_BUILD', value: 'true' }
      steps {
        sh '''
          set -eux
          if npm run | grep -q " typecheck"; then
            npm run typecheck
          else
            echo "typecheck 스크립트 없음. 건너뜀."
          fi
        '''
      }
    }

    stage('Build') {
      // main은 빌드 스킵 (CD에서 빌드하므로 중복 제거)
      // release-* 브랜치에서만 빌드 검증
      when {
        allOf {
          environment name: 'SHOULD_BUILD', value: 'true'
          not { branch 'main' }
        }
      }
      environment {
        // CI 빌드 검증용 더미 환경변수 (실제 값은 운영 서버 .env에서 로드)
        NEXTAUTH_SECRET = 'ci-build-dummy-secret'
        GUEST_TOKEN_SECRET = 'ci-build-dummy-secret'
        JWT_SECRET = 'ci-build-dummy-secret'
      }
      steps {
        sh '''
          set -eux
          npm run build:shop
          npm run build:sourcing
        '''
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: '**/junit.xml'
      // 빌드 완료 후 워크스페이스 정리 (디스크 공간 확보)
      cleanWs()
    }
  }
}
