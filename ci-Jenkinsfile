pipeline {
  agent any

  options {
    timestamps()
    disableConcurrentBuilds()
  }

  environment {
    CI = 'true'
    NEXT_TELEMETRY_DISABLED = '1'
    NEXTAUTH_SECRET = credentials('nextauth-secret')
    GUEST_TOKEN_SECRET = credentials('guest-secret')
    JWT_SECRET = credentials('jwt-secret')
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Setup') {
      steps {
        sh '''
          set -eux
          node -v
          npm -v
        '''
      }
    }
stage('Debug') {
  steps {
    sh '''
      set -eux
      git rev-parse HEAD
      git log -1 --oneline
      ls -al package.json package-lock.json
      node -e "console.log('pkg nodemailer=', require('./package.json').dependencies?.nodemailer || require('./package.json').devDependencies?.nodemailer)"
      node -e "console.log('lock nodemailer=', require('./package-lock.json').packages?.['']?.dependencies?.nodemailer)"
    '''
  }
}
    stage('Install') {
      steps {
        sh '''
          set -eux
          npm ci
        '''
      }
    }

    stage('Generate Prisma Client') {
      steps {
        sh '''
          set -eux
          cd db
          npx prisma generate --schema prisma
          cd ..
        '''
      }
    }

    stage('Lint') {
      steps {
        sh '''
          set -eux
          if npm run | grep -q " lint"; then
            npm run lint
          else
            echo "No lint script. Skip."
          fi
        '''
      }
    }

    stage('Typecheck') {
      steps {
        sh '''
          set -eux
          if npm run | grep -q " typecheck"; then
            npm run typecheck
          else
            echo "No typecheck script. Skip."
          fi
        '''
      }
    }


    stage('Build') {
      steps {
        sh '''
          set -eux
          npm run build:shop
          npm run build:sourcing
        '''
      }
    }
  }

  post {
    always {
      junit allowEmptyResults: true, testResults: '**/junit.xml'
      archiveArtifacts artifacts: '.next/**', allowEmptyArchive: true
    }
  }
}